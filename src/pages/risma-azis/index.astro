    <!-- JAVASCRIPT -->
    <script src="https://www.youtube.com/iframe_api" is:inline></script>
    <script is:inline>
      let ytPlayer;
      let ytReady = false;
      
      // Dipanggil otomatis oleh API YouTube saat library selesai dimuat
      function onYouTubeIframeAPIReady() {
        ytPlayer = new YT.Player('youtube-player', {
          height: '0',
          width: '0',
          videoId: 'aW-gVl3M99c', // GANTI ID YOUTUBE DI SINI
          playerVars: {
            'autoplay': 0,
            'controls': 0,
            'disablekb': 1,
            'loop': 1,
            'playsinline': 1
          },
          events: {
            'onReady': () => { ytReady = true; }
          }
        });
      }

      // Copy Number & Toast Logic
      function copyNumber(number, bank) {
        navigator.clipboard.writeText(number).then(() => {
          const toast = document.getElementById('toast');
          const toastMsg = document.getElementById('toast-msg');
          toastMsg.innerText = `Nomor ${bank} berhasil disalin!`;
          
          toast.classList.remove('opacity-0', '-translate-y-5');
          toast.classList.add('opacity-100', 'translate-y-0');
          
          setTimeout(() => {
            toast.classList.remove('opacity-100', 'translate-y-0');
            toast.classList.add('opacity-0', '-translate-y-5');
          }, 3000);
        });
      }

      document.addEventListener('DOMContentLoaded', () => {
        
        // 1. Cover Overlay logic
        const coverOverlay = document.getElementById('cover-overlay');
        const btnOpen = document.getElementById('btn-open');
        const body = document.body;

        if (btnOpen && coverOverlay) {
          btnOpen.addEventListener('click', () => {
            coverOverlay.classList.add('open');
            body.classList.remove('locked');
            
            // Play YouTube when opened (Interaksi user diperlukan browser)
            if(ytReady && ytPlayer && ytPlayer.playVideo) {
              ytPlayer.playVideo();
            }

            setTimeout(() => { coverOverlay.style.display = 'none'; }, 1000);
          });
        }

        // 2. Intersection Observer for Reveals
        const revealElements = document.querySelectorAll('.reveal, .reveal-scale');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

        revealElements.forEach(el => observer.observe(el));

        // 3. Countdown Timer (Dummy date for visual)
        const countDate = new Date('2026-11-15T08:00:00').getTime();
        function updateCount() {
          const now = new Date().getTime();
          const gap = countDate - now;

          if (gap <= 0) return;

          const second = 1000, minute = second * 60, hour = minute * 60, day = hour * 24;
          
          document.getElementById('days').innerText = Math.floor(gap / day);
          document.getElementById('hours').innerText = String(Math.floor((gap % day) / hour)).padStart(2, '0');
          document.getElementById('minutes').innerText = String(Math.floor((gap % hour) / minute)).padStart(2, '0');
          const secEl = document.getElementById('seconds');
          if(secEl) secEl.innerText = String(Math.floor((gap % minute) / second)).padStart(2, '0');
        }
        setInterval(updateCount, 1000);
        updateCount();

        // 4. Audio Button Toggle
        const audioBtn = document.getElementById('audio-btn');
        const iconUnmute = document.getElementById('icon-unmute');
        const iconMute = document.getElementById('icon-mute');
        let playing = true;
        
        if(audioBtn) {
          audioBtn.addEventListener('click', () => {
            if(!ytReady || !ytPlayer) return;
            
            if(playing) {
              ytPlayer.pauseVideo();
              iconUnmute.classList.add('hidden');
              iconMute.classList.remove('hidden');
              audioBtn.style.opacity = '0.7';
            } else {
              ytPlayer.playVideo();
              iconMute.classList.add('hidden');
              iconUnmute.classList.remove('hidden');
              audioBtn.style.opacity = '1';
            }
            playing = !playing;
          });
        }

        // 5. Form RSVP Guestbook (Local Simulation)
        const form = document.getElementById('rsvp-form');
        const guestbookList = document.getElementById('guestbook-list');
        const emptyState = document.getElementById('empty-state');

        if(form) {
          form.addEventListener('submit', (e) => {
            e.preventDefault();
            const name = document.getElementById('guest-name').value;
            const presence = document.getElementById('guest-presence').value;
            const message = document.getElementById('guest-message').value;

            if(emptyState) emptyState.style.display = 'none';

            // Create new guestbook element
            const entry = document.createElement('div');
            entry.className = 'bg-jawa-darker/60 border border-jawa-gold/20 p-4 rounded-lg transform transition-all duration-500 scale-95 opacity-0';
            entry.innerHTML = `
              <p class="font-sans text-sm font-semibold text-jawa-gold mb-1">${name}</p>
              <p class="font-sans text-[10px] text-jawa-cream/50 mb-2">${presence} • Baru saja</p>
              <p class="font-sans text-xs text-jawa-cream/90 leading-relaxed">${message}</p>
            `;

            guestbookList.prepend(entry);
            
            // Animation
            setTimeout(() => {
              entry.classList.remove('scale-95', 'opacity-0');
            }, 10);

            // Reset form
            form.reset();
          });
        }
      });
    </script>
