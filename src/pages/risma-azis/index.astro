          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
      >
      <span id="toast-msg">Nomor berhasil disalin!</span>
    </div>

    <!-- JAVASCRIPT -->
    <script src="https://www.youtube.com/iframe_api" is:inline></script>
    <script is:inline>
      let ytPlayer;
      let ytReady = false;
      let isMusicPlaying = false;

      // Dipanggil otomatis oleh API YouTube saat library selesai dimuat
      function onYouTubeIframeAPIReady() {
        ytPlayer = new YT.Player("youtube-player", {
          height: "0",
          width: "0",
          videoId: "i80Se1ihe1Y", // Diperbarui sesuai request (Payung Teduh)
          playerVars: {
            autoplay: 0,
            controls: 0,
            disablekb: 1,
            loop: 1,
            playsinline: 1,
            start: 78, // Mulai dari 1:17 (77 detik)
          },
          events: {
            onReady: () => {
              ytReady = true;
            },
          },
        });
      }

      // Copy Number & Toast Logic
      function copyNumber(number, bank) {
        navigator.clipboard.writeText(number).then(() => {
          const toast = document.getElementById("toast");
          const toastMsg = document.getElementById("toast-msg");
          toastMsg.innerText = `Nomor ${bank} berhasil disalin!`;

          toast.classList.remove("opacity-0", "-translate-y-5");
          toast.classList.add("opacity-100", "translate-y-0");

          setTimeout(() => {
            toast.classList.remove("opacity-100", "translate-y-0");
            toast.classList.add("opacity-0", "-translate-y-5");
          }, 3000);
        });
      }

      document.addEventListener("DOMContentLoaded", () => {
        // 0. URL Parameter Logic
        const urlParams = new URLSearchParams(window.location.search);
        const guestTo = urlParams.get("to");

        const coverGuestName = document.getElementById("cover-guest-name");
        const formContainer = document.getElementById("rsvp-form-container");
        const lockedMsg = document.getElementById("rsvp-locked-msg");
        const inputName = document.getElementById("guest-name");

        if (guestTo) {
          if (coverGuestName) coverGuestName.textContent = guestTo;
          if (inputName) {
            inputName.value = guestTo;
            inputName.readOnly = true;
            inputName.classList.add(
              "bg-jawa-cream/50",
              "text-jawa-dark/70",
              "cursor-not-allowed",
              "border-transparent",
            );
            inputName.classList.remove("bg-white");
          }
        } else {
          // No 'to' parameter -> lock form
          if (formContainer && lockedMsg) {
            formContainer.classList.add("hidden");
            lockedMsg.classList.remove("hidden");
          }
        }

        // 1. Cover Overlay logic
        const coverOverlay = document.getElementById("cover-overlay");
        const btnOpen = document.getElementById("btn-open");
        const body = document.body;

        if (btnOpen && coverOverlay) {
          btnOpen.addEventListener("click", () => {
            coverOverlay.classList.add("open");
            body.classList.remove("locked");

            // Masuk ke mode fullscreen
            try {
              if (document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen().catch(() => {});
              } else if (document.documentElement.webkitRequestFullscreen) {
                document.documentElement.webkitRequestFullscreen();
              }
            } catch (err) {
              console.log("Gagal masuk fullscreen:", err);
            }

            // Play YouTube when opened (Interaksi user diperlukan browser)
            if (ytReady && ytPlayer && ytPlayer.playVideo) {
              ytPlayer.playVideo();
              isMusicPlaying = true;

              const ab = document.getElementById("audio-btn");
              const iconUnmute = document.getElementById("icon-unmute");
              const iconMute = document.getElementById("icon-mute");

              if (ab) {
                ab.classList.add("animate-[spin_4s_linear_infinite]");
                ab.style.opacity = "1";
              }
              if (iconUnmute) iconUnmute.classList.remove("hidden");
              if (iconMute) iconMute.classList.add("hidden");
            }

            setTimeout(() => {
              coverOverlay.style.display = "none";
            }, 1000);
          });
        }

        // 2. Intersection Observer for Reveals
        const revealElements = document.querySelectorAll(
          ".reveal, .reveal-scale",
        );
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px 300px 0px" },
        );

        revealElements.forEach((el) => observer.observe(el));

        // 3. Countdown Timer (Dummy date for visual)
        const countDate = new Date("2026-11-15T08:00:00").getTime();
        function updateCount() {
          const now = new Date().getTime();
          const gap = countDate - now;

          if (gap <= 0) return;

          const second = 1000,
            minute = second * 60,
            hour = minute * 60,
            day = hour * 24;

          document.getElementById("days").innerText = Math.floor(gap / day);
          document.getElementById("hours").innerText = String(
            Math.floor((gap % day) / hour),
          ).padStart(2, "0");
          document.getElementById("minutes").innerText = String(
            Math.floor((gap % hour) / minute),
          ).padStart(2, "0");
          const secEl = document.getElementById("seconds");
          if (secEl)
            secEl.innerText = String(
              Math.floor((gap % minute) / second),
            ).padStart(2, "0");
        }
        setInterval(updateCount, 1000);
        updateCount();

        // 4. Audio Button Toggle
        const audioBtn = document.getElementById("audio-btn");
        const iconUnmute = document.getElementById("icon-unmute");
        const iconMute = document.getElementById("icon-mute");

        if (audioBtn) {
          audioBtn.addEventListener("click", () => {
            if (!ytReady || !ytPlayer) return;

            if (isMusicPlaying) {
              ytPlayer.pauseVideo();
              isMusicPlaying = false;
              iconUnmute.classList.add("hidden");
              iconMute.classList.remove("hidden");
              audioBtn.style.opacity = "0.7";
              audioBtn.classList.remove("animate-[spin_4s_linear_infinite]");
            } else {
              ytPlayer.playVideo();
              isMusicPlaying = true;
              iconMute.classList.add("hidden");
              iconUnmute.classList.remove("hidden");
              audioBtn.style.opacity = "1";
              audioBtn.classList.add("animate-[spin_4s_linear_infinite]");
            }
          });
        }

        // Auto-resume audio when returning to tab
        document.addEventListener("visibilitychange", () => {
          if (!document.hidden && isMusicPlaying && ytReady && ytPlayer) {
            ytPlayer.playVideo();
          }
        });

        // ─────────────────────────────────────────────────────
        // 5. RSVP & Guestbook — Google Sheets Integration
        // ─────────────────────────────────────────────────────

        /**
         * 🔴 PENTING: Ganti URL ini dengan Web App URL Google Apps Script Anda.
         * Cara deploy ada di file Code.gs (lihat komentar di atas).
         */
        const SCRIPT_URL =
          "https://script.google.com/macros/s/AKfycbw5NE-CQaPFJhlSxb6CQEdyJBZxq-SLzQF5uiBG887X0EcdPqDMqG-DAgsqBlfZXBpOvw/exec";

        // ── Utility: Format timestamp relatif ────────────────
        function timeAgo(isoString) {
          if (!isoString) return "";
          const diff = Date.now() - new Date(isoString).getTime();
          const mins = Math.floor(diff / 60000);
          const hours = Math.floor(diff / 3600000);
          const days = Math.floor(diff / 86400000);
          if (mins < 1) return "Baru saja";
          if (mins < 60) return `${mins} menit lalu`;
          if (hours < 24) return `${hours} jam lalu`;
          if (days < 7) return `${days} hari lalu`;
          return new Date(isoString).toLocaleDateString("id-ID", {
            day: "numeric",
            month: "short",
            year: "numeric",
          });
        }

        // ── Utility: Buat card ucapan ─────────────────────────
        function createEntryCard(entry, animate = false) {
          const isHadir = entry.kehadiran === "Hadir";
          const badgeClass = isHadir
            ? "bg-emerald-900/40 text-emerald-400 border border-emerald-700/40"
            : "bg-red-900/40 text-red-400 border border-red-800/40";

          const card = document.createElement("div");
          card.className = [
            "bg-jawa-darker/60 border border-jawa-gold/20 p-4 rounded-lg",
            "transform transition-all duration-500",
            animate ? "scale-95 opacity-0" : "",
          ].join(" ");

          // Escape ucapan untuk keamanan tampilan
          const safeUcapan = entry.ucapan
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
          const safeName = entry.nama
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");

          card.innerHTML = `
            <div class="flex items-start justify-between gap-2 mb-2">
              <p class="font-sans text-sm font-semibold text-jawa-gold leading-tight">${safeName}</p>
              <span class="shrink-0 text-[9px] font-sans font-semibold px-2 py-0.5 rounded-full ${badgeClass}">
                ${isHadir ? "✅ Hadir" : "❌ Tidak Hadir"}
              </span>
            </div>
            <p class="font-sans text-xs text-jawa-cream/90 leading-relaxed mb-2">${safeUcapan}</p>
            <p class="font-sans text-[10px] text-jawa-cream/40">${timeAgo(entry.timestamp)}</p>
          `;

          return card;
        }

        // ── Pagination State ──────────────────────────────────
        const ITEMS_PER_PAGE = 10;
        let allGuestEntries = [];
        let currentGuestPage = 1;

        function renderGuestPage(page) {
          const list = document.getElementById("guestbook-list");
          const empty = document.getElementById("empty-state");
          const skeleton = document.getElementById("guestbook-skeleton");
          const pagination = document.getElementById("guestbook-pagination");
          const pageInfo = document.getElementById("page-info");
          const prevBtn = document.getElementById("page-prev");
          const nextBtn = document.getElementById("page-next");
          if (!list) return;

          // Sembunyikan skeleton
          if (skeleton) skeleton.classList.add("hidden");

          // Hapus card lama
          [...list.children].forEach((el) => {
            if (el.id !== "guestbook-skeleton" && el.id !== "empty-state")
              el.remove();
          });

          if (allGuestEntries.length === 0) {
            if (empty) empty.classList.remove("hidden");
            if (pagination) pagination.classList.add("hidden");
            return;
          }

          if (empty) empty.classList.add("hidden");

          const totalPages = Math.ceil(allGuestEntries.length / ITEMS_PER_PAGE);
          currentGuestPage = Math.max(1, Math.min(page, totalPages));
          const start = (currentGuestPage - 1) * ITEMS_PER_PAGE;
          const pageEntries = allGuestEntries.slice(
            start,
            start + ITEMS_PER_PAGE,
          );

          pageEntries.forEach((entry) =>
            list.appendChild(createEntryCard(entry, false)),
          );

          // Tampilkan / update pagination
          if (totalPages > 1) {
            if (pagination) pagination.classList.remove("hidden");
            if (pageInfo)
              pageInfo.textContent = `Hal ${currentGuestPage} / ${totalPages}`;
            if (prevBtn) prevBtn.disabled = currentGuestPage === 1;
            if (nextBtn) nextBtn.disabled = currentGuestPage === totalPages;
          } else {
            if (pagination) pagination.classList.add("hidden");
          }

          list.scrollTop = 0;
        }

        window.guestPrevPage = () => renderGuestPage(currentGuestPage - 1);
        window.guestNextPage = () => renderGuestPage(currentGuestPage + 1);

        // ── Load Guestbook dari Google Sheets ─────────────────
        async function loadGuestbook() {
          const list = document.getElementById("guestbook-list");
          const skeleton = document.getElementById("guestbook-skeleton");
          const empty = document.getElementById("empty-state");

          if (!list) return;

          // Tampilkan skeleton
          if (skeleton) skeleton.classList.remove("hidden");
          if (empty) empty.classList.add("hidden");

          try {
            const res = await fetch(`${SCRIPT_URL}?action=getAll`, {
              cache: "no-store",
            });
            const json = await res.json();

            allGuestEntries = json.data || [];
            renderGuestPage(1);
          } catch (err) {
            if (skeleton) skeleton.classList.add("hidden");
            console.error("Gagal memuat guestbook:", err);
            const errEl = document.createElement("p");
            errEl.className =
              "text-center text-jawa-cream/40 font-sans text-xs mt-6";
            errEl.textContent = "Gagal memuat ucapan. Coba refresh.";
            list.appendChild(errEl);
          }
        }

        // ── Load Statistik Kehadiran ──────────────────────────
        async function loadStats() {
          try {
            const res = await fetch(`${SCRIPT_URL}?action=summary`, {
              cache: "no-store",
            });
            const json = await res.json();
            if (json.status === "success" && json.data) {
              const el = document.getElementById("rsvp-stats");
              if (el) {
                document.getElementById("stat-hadir").textContent =
                  json.data.hadir;
                document.getElementById("stat-tidak").textContent =
                  json.data.tidakHadir;
                el.style.opacity = "1";
              }
            }
          } catch (_) {
            /* Silent fail — statistik tidak kritis */
          }
        }

        // ── Submit Form RSVP ──────────────────────────────────
        const rsvpForm = document.getElementById("rsvp-form");
        const submitBtn = document.getElementById("rsvp-submit-btn");
        const btnText = document.getElementById("rsvp-btn-text");
        const spinner = document.getElementById("rsvp-spinner");
        const errorBox = document.getElementById("rsvp-error");
        const successBox = document.getElementById("rsvp-success");
        const charCountEl = document.getElementById("char-count");
        const messageInput = document.getElementById("guest-message");

        // Karakter counter
        if (messageInput && charCountEl) {
          messageInput.addEventListener("input", () => {
            const len = messageInput.value.length;
            charCountEl.textContent = `${len} / 500`;
            charCountEl.style.color = len > 450 ? "#ef4444" : "";
          });
        }

        if (rsvpForm) {
          rsvpForm.addEventListener("submit", async (e) => {
            e.preventDefault();

            const nama = document.getElementById("guest-name").value.trim();
            const kehadiranElem = document.querySelector(
              'input[name="kehadiran"]:checked',
            );
            const kehadiran = kehadiranElem ? kehadiranElem.value : "";
            const ucapan = messageInput ? messageInput.value.trim() : "";

            // Validasi sisi klien
            if (!nama || !kehadiran || !ucapan) {
              errorBox.textContent = "Semua field wajib diisi.";
              errorBox.classList.remove("hidden");
              return;
            }
            errorBox.classList.add("hidden");
            successBox.classList.add("hidden");

            // Loading state
            submitBtn.disabled = true;
            btnText.textContent = "Mengirim…";
            spinner.classList.remove("hidden");

            try {
              const res = await fetch(SCRIPT_URL, {
                method: "POST",
                headers: { "Content-Type": "text/plain" }, // text/plain avoids CORS preflight on GAS
                body: JSON.stringify({ nama, kehadiran, ucapan }),
              });
              const json = await res.json();

              if (json.status === "success") {
                // Tampilkan success
                successBox.classList.remove("hidden");
                rsvpForm.reset();
                if (charCountEl) charCountEl.textContent = "0 / 500";

                // Tambahkan entri baru ke awal array & tampilkan halaman 1
                allGuestEntries.unshift({
                  nama,
                  kehadiran,
                  ucapan,
                  timestamp: new Date().toISOString(),
                });
                renderGuestPage(1);

                // Sembunyikan success setelah 4 detik
                setTimeout(() => successBox.classList.add("hidden"), 4000);

                // Reload statistik
                loadStats();
              } else {
                errorBox.textContent =
                  json.message || "Terjadi kesalahan. Coba lagi.";
                errorBox.classList.remove("hidden");
              }
            } catch (err) {
              console.error("Submit error:", err);
              errorBox.textContent =
                "Gagal terhubung ke server. Periksa koneksi internet Anda.";
              errorBox.classList.remove("hidden");
            } finally {
              // Reset tombol
              submitBtn.disabled = false;
              btnText.textContent = "Kirim Pesan";
              spinner.classList.add("hidden");
            }
          });
        }

        // ── Inisialisasi: Muat data saat halaman siap ─────────
        // Expose ke global agar tombol refresh bisa memanggil langsung
        window.loadGuestbook = loadGuestbook;

        // Delay sedikit agar animasi reveal selesai dulu
        setTimeout(() => {
          loadGuestbook();
          loadStats();
        }, 800);
      });
    </script>
  </body>
</html>
