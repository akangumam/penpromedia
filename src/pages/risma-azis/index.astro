---
/**
 * Undangan Pernikahan Digital — Risma & Azis
 * Tema: Adat Jawa (Elegan & Klasik)
 * Penpromedia
 */
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <link rel="preload" as="image" href="/assets/img/risma-azis/photo-1.avif" fetchpriority="high" />
    <link rel="preload" as="image" href="/assets/img/wayang.svg" fetchpriority="high" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Undangan Pernikahan Risma & Azis — Adat Jawa</title>

    <meta
      name="description"
      content="Anda diundang ke pernikahan Risma & Azis pada 15 November 2026."
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Penpromedia" />
    <meta property="og:title" content="Undangan Pernikahan Risma & Azis" />
    <meta
      property="og:description"
      content="Anda diundang ke pernikahan Risma & Azis pada 15 November 2026."
    />
    <meta
      property="og:image"
      content="https://penpromedia.web.id/assets/img/risma-azis/photo-1.avif"
    />
    <link
      rel="icon"
      type="image/png"
      href="/assets/img/penpromedia_favicon.png"
    />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Montserrat:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              jawa: {
                dark: "#2E2218", // Rustic Dark Brown
                darker: "#1F150F", // Deepest Brown
                gold: "#D4AF37", // Antique Gold
                goldLight: "#E8C988", // Light Gold
                cream: "#FDF6E3", // Warm Cream Paper
                creamDark: "#EEDFCC", // Darker Cream
              },
            },
            fontFamily: {
              serif: ["Playfair Display", "serif"],
              script: ["Great Vibes", "cursive"],
              sans: ["Montserrat", "sans-serif"],
            },
            backgroundImage: {
              batik:
                "url('data:image/svg+xml,%3Csvg width=\\'60\\' height=\\'60\\' viewBox=\\'0 0 60 60\\' xmlns=\\'http://www.w3.org/2000/svg\\'%3E%3Cpath d=\\'M30 0l30 30-30 30L0 30 30 0zm0 15L15 30l15 15 15-15-15-15zm0 10l5 5-5 5-5-5 5-5z\\' fill=\\'%23D4AF37\\' fill-opacity=\\'0.05\\' fill-rule=\\'evenodd\\'/%3E%3C/svg%3E')",
              "batik-cream":
                "url('data:image/svg+xml,%3Csvg width=\\'60\\' height=\\'60\\' viewBox=\\'0 0 60 60\\' xmlns=\\'http://www.w3.org/2000/svg\\'%3E%3Cpath d=\\'M30 0l30 30-30 30L0 30 30 0zm0 15L15 30l15 15 15-15-15-15zm0 10l5 5-5 5-5-5 5-5z\\' fill=\\'%232E2218\\' fill-opacity=\\'0.04\\' fill-rule=\\'evenodd\\'/%3E%3C/svg%3E')",
            },
          },
        },
      };
    </script>

    <style is:inline>
      html,
      body {
        background-color: #2e2218;
        color: #fdf6e3;
        overflow-x: hidden;
      }

      /* CSS Variables */
      :root {
        --jawa-gold: #d4af37;
        --jawa-dark: #2e2218;
      }

      /* Base Animations */
      @keyframes float {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-10px);
        }
      }
      @keyframes pulse-gold {
        0%,
        100% {
          box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.4);
        }
        50% {
          box-shadow: 0 0 0 10px rgba(212, 175, 55, 0);
        }
      }
      @keyframes slideUpFade {
        from {
          opacity: 0;
          transform: translateY(40px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Scroll Revel */
      .reveal {
        opacity: 0;
        transform: translateY(40px);
        transition:
          opacity 0.8s cubic-bezier(0.5, 0, 0, 1),
          transform 0.8s cubic-bezier(0.5, 0, 0, 1);
      }
      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }
      .reveal-scale {
        opacity: 0;
        transform: scale(0.9);
        transition:
          opacity 0.8s ease,
          transform 0.8s ease;
      }
      .reveal-scale.visible {
        opacity: 1;
        transform: scale(1);
      }

      .stagger-1 {
        transition-delay: 0.1s;
      }
      .stagger-2 {
        transition-delay: 0.2s;
      }
      .stagger-3 {
        transition-delay: 0.3s;
      }
      .stagger-4 {
        transition-delay: 0.4s;
      }

      /* Elegant Arch Frame */
      .arch-frame {
        position: relative;
        padding: 8px;
        border-radius: 1000px 1000px 12px 12px;
        background: transparent;
        border: 1px solid rgba(212, 175, 55, 0.4);
      }
      .arch-frame::before {
        content: "";
        position: absolute;
        inset: -6px;
        border-radius: 1000px 1000px 16px 16px;
        border: 1px solid rgba(212, 175, 55, 0.15);
      }
      .arch-inner {
        width: 100%;
        height: 100%;
        border-radius: 1000px 1000px 8px 8px;
        overflow: hidden;
      }

      /* Double Border Box */
      .vintage-box {
        position: relative;
        padding: 24px;
        background: #fdf6e3;
        border: 1px solid #d4af37;
      }
      .vintage-box::after {
        content: "";
        position: absolute;
        inset: 4px;
        border: 1px solid rgba(212, 175, 55, 0.4);
        pointer-events: none;
      }

      /* Envelope Design */
      .envelope {
        background: #fdf6e3;
        border-radius: 8px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(212, 175, 55, 0.3);
      }
      .envelope-flap {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 40px;
        background: #eedfcc;
        clip-path: polygon(0 0, 100% 0, 50% 100%);
        border-bottom: 1px solid rgba(212, 175, 55, 0.2);
      }

      /* Timeline Line */
      .timeline-line::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 2px;
        background: rgba(212, 175, 55, 0.3);
        transform: translateX(-50%);
      }

      /* Cover Interaction */
      #cover-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background-color: var(--jawa-dark);
        transition: transform 1s cubic-bezier(0.77, 0, 0.175, 1);
      }
      #cover-overlay.open {
        transform: translateY(-100%);
      }
      body.locked {
        overflow: hidden;
        height: 100vh;
        touch-action: none;
      }

      .btn-gold {
        background: transparent;
        border: 1px solid var(--jawa-gold);
        color: var(--jawa-gold);
        transition: all 0.3s ease;
      }
      .btn-gold:hover {
        background: var(--jawa-gold);
        color: var(--jawa-dark);
      }
    </style>
  </head>

  <body class="font-sans locked antialiased bg-batik bg-fixed">
    <!-- Hapus trailing hash (#) jika ada -->
    <script is:inline>
      if (window.location.hash === '' && window.location.href.endsWith('#')) {
        window.history.replaceState(null, '', window.location.pathname + window.location.search);
      }
    </script>
    
    <!-- ==========================================
         COVER / FRONT DOOR
         ========================================== -->
    <div
      id="cover-overlay"
      class="relative w-full h-screen flex flex-col items-center justify-center overflow-hidden"
    >
      <!-- Background Image -->
      <div class="absolute inset-0">
        <img decoding="async"
          src="/assets/img/risma-azis/photo-1.avif"
          alt="Cover"
          class="w-full h-full object-cover"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-jawa-darker via-jawa-dark/80 to-jawa-darker/50"
        >
        </div>
      </div>

      <!-- Ornaments -->
      <div class="absolute top-10 w-full flex justify-center">
        <!-- SVG Gunungan Image -->
        <img decoding="async"
          src="/assets/img/wayang.svg"
          alt="Wayang"
          class="w-32 h-32 object-contain"
          style="animation: slideUpFade 1.5s ease forwards"
        />
      </div>

      <!-- Content -->
      <div
        class="relative z-10 text-center px-6 mt-16"
        style="animation: slideUpFade 1.5s ease forwards"
      >
        <p
          class="font-sans text-xs tracking-[0.3em] text-jawa-goldLight uppercase mb-4"
        >
          The Wedding Of
        </p>
        <h1
          class="font-serif text-5xl sm:text-6xl text-jawa-gold mb-2 leading-tight"
        >
          Risma <br />
          <span class="font-script text-4xl sm:text-5xl text-jawa-cream mx-2"
            >&amp;</span
          >
          <br />
          Azis
        </h1>

        <div class="my-8 flex items-center justify-center gap-4">
          <div class="w-12 h-[1px] bg-jawa-gold/50"></div>
          <p class="font-sans text-sm tracking-widest text-jawa-cream">
            15 . 11 . 2026
          </p>
          <div class="w-12 h-[1px] bg-jawa-gold/50"></div>
        </div>

        <p class="font-sans text-xs text-jawa-cream/70 mb-4">
          Kepada Yth. Bapak/Ibu/Saudara/i
        </p>
        <p
          id="cover-guest-name"
          class="font-serif text-xl text-jawa-gold font-medium mb-10"
        >
          Tamu Undangan
        </p>

        <button
          id="btn-open"
          class="inline-flex items-center gap-2 px-8 py-3 btn-gold rounded-full text-xs tracking-widest uppercase"
          style="animation: pulse-gold 2s infinite"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M3 19v-8.93a2 2 0 01.89-1.664l7-4.666a2 2 0 012.22 0l7 4.666A2 2 0 0121 10.07V19M3 19a2 2 0 002 2h14a2 2 0 002-2M3 19l6.75-4.5M21 19l-6.75-4.5M3 10l6.75 4.5M21 10l-6.75 4.5m0 0l-1.14.76a2 2 0 01-2.22 0l-1.14-.76"
            ></path></svg
          >
          Buka Undangan
        </button>
      </div>
    </div>

    <!-- ==========================================
         MAIN CONTENT
         ========================================== -->
    <main class="relative z-0">
      <!-- HEADER / AYAT SECTION -->
      <section
        class="py-24 px-6 relative overflow-hidden flex flex-col items-center text-center"
      >
        <!-- Giant Watermark Initials -->
        <div
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-serif text-[200px] text-jawa-gold opacity-5 select-none pointer-events-none leading-none"
        >
          R&A
        </div>

        <div class="max-w-2xl relative z-10 reveal">
          <p class="font-serif text-xl sm:text-2xl text-jawa-gold mb-6 italic">
            "Dan di antara tanda-tanda kekuasaan-Nya ialah Dia menciptakan
            untukmu istri-istri dari jenismu sendiri..."
          </p>
          <p class="font-sans text-sm text-jawa-cream/80 leading-relaxed mb-6">
            Supaya kamu cenderung dan merasa tenteram kepadanya, dan
            dijadikan-Nya di antaramu rasa kasih dan sayang. Sesungguhnya pada
            yang demikian itu benar-benar terdapat tanda-tanda bagi kaum yang
            berfikir.
          </p>
          <p
            class="font-sans text-xs tracking-widest text-jawa-goldLight uppercase"
          >
            — QS. Ar-Rum: 21
          </p>
        </div>
      </section>

      <!-- PROFILE SECTION -->
      <section
        class="py-20 px-6 bg-jawa-cream bg-batik-cream text-jawa-dark"
        id="profile"
      >
        <div class="max-w-4xl mx-auto text-center">
          <div class="mb-16 reveal">
            <h2 class="font-script text-4xl text-jawa-gold mb-2">
              Sang Mempelai
            </h2>
            <div class="flex justify-center items-center gap-2">
              <span class="w-8 h-px bg-jawa-gold"></span>
              <span class="w-2 h-2 bg-jawa-gold transform rotate-45"></span>
              <span class="w-8 h-px bg-jawa-gold"></span>
            </div>
          </div>

          <div
            class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-8 items-center"
          >
            <!-- Bride -->
            <div class="flex flex-col items-center reveal stagger-1">
              <div class="w-72 sm:w-96 mb-6">
                <div class="arch-frame">
                  <div class="arch-inner">
                    <img decoding="async"
                      src="/assets/img/risma-azis/risma.avif"
                      alt="Risma"
                      class="w-full h-[400px] sm:h-[500px] object-cover"
                    />
                  </div>
                </div>
              </div>
              <h3 class="font-serif text-3xl font-bold text-jawa-dark mb-2">
                Rismawati
              </h3>
              <p class="font-sans text-sm text-jawa-dark/70 mb-4">
                Putri dari<br />Bapak Sarnan & Ibu Sukesih
              </p>
            </div>

            <!-- Ampersand -->
            <div
              class="hidden md:flex justify-center items-center reveal stagger-2"
            >
              <span class="font-script text-6xl text-jawa-gold">&amp;</span>
            </div>
            <div
              class="md:hidden flex justify-center items-center reveal stagger-2"
            >
              <span class="font-script text-5xl text-jawa-gold">&amp;</span>
            </div>

            <!-- Groom -->
            <div
              class="flex flex-col items-center reveal stagger-3 md:-mt-0 mt-8"
            >
              <div class="w-72 sm:w-96 mb-6">
                <div class="arch-frame">
                  <div class="arch-inner">
                    <img decoding="async"
                      src="/assets/img/risma-azis/azis.avif"
                      alt="Azis"
                      class="w-full h-[400px] sm:h-[500px] object-cover"
                    />
                  </div>
                </div>
              </div>
              <h3 class="font-serif text-3xl font-bold text-jawa-dark mb-2">
                Azis Sulaeman
              </h3>
              <p class="font-sans text-sm text-jawa-dark/70 mb-4">
                Putra dari<br />Bapak Saipan & Ibu Sari'ah
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- EVENT DETAILS -->
      <section class="py-24 px-6 text-center" id="events">
        <div class="max-w-4xl mx-auto">
          <div class="reveal mb-16">
            <h2 class="font-script text-4xl text-jawa-gold mb-2">
              Save the Date
            </h2>
            <h3 class="font-serif text-3xl text-jawa-cream font-medium">
              Rangkaian Acara
            </h3>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
            <!-- Akad -->
            <div class="vintage-box reveal stagger-1 text-jawa-dark shadow-2xl">
              <!-- Corner Ornaments simulated by borders -->
              <div class="mb-6 flex justify-center text-jawa-gold">
                <svg
                  class="w-12 h-12"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1"
                    d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
                  ></path></svg
                >
              </div>
              <h4 class="font-serif text-2xl font-bold mb-2">Akad Nikah</h4>
              <p
                class="font-sans text-sm font-semibold tracking-wide text-jawa-gold mb-4"
              >
                MINGGU, 15 NOVEMBER 2026
              </p>
              <p class="font-sans text-sm mb-4">Pukul 08.00 WIB - Selesai</p>
              <div class="w-full h-px bg-jawa-gold/30 my-4"></div>
              <p class="font-sans text-sm leading-relaxed mb-6">
                <strong>Kp. Binuang Pasar</strong><br />
                Ds. Binuang Kec. Binuang 007/002
              </p>
              <a
                href="https://maps.app.goo.gl/jgXw7FjN7BKySM6x5"
                target="_blank"
                class="inline-block border border-jawa-dark text-jawa-dark px-6 py-2 text-xs font-semibold uppercase tracking-widest hover:bg-jawa-dark hover:text-jawa-cream transition-colors"
                >Lihat Lokasi</a
              >
            </div>

            <!-- Resepsi -->
            <div class="vintage-box reveal stagger-2 text-jawa-dark shadow-2xl">
              <div class="mb-6 flex justify-center text-jawa-gold">
                <svg
                  class="w-12 h-12"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1"
                    d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"
                  ></path></svg
                >
              </div>
              <h4 class="font-serif text-2xl font-bold mb-2">Resepsi Adat</h4>
              <p
                class="font-sans text-sm font-semibold tracking-wide text-jawa-gold mb-4"
              >
                MINGGU, 15 NOVEMBER 2026
              </p>
              <p class="font-sans text-sm mb-4">Pukul 08.00 WIB - Selesai</p>
              <div class="w-full h-px bg-jawa-gold/30 my-4"></div>
              <p class="font-sans text-sm leading-relaxed mb-6">
                <strong>Kp. Binuang Pasar</strong><br />
                Ds. Binuang Kec. Binuang 007/002
              </p>
              <a
                href="https://maps.app.goo.gl/jgXw7FjN7BKySM6x5"
                target="_blank"
                class="inline-block border border-jawa-dark text-jawa-dark px-6 py-2 text-xs font-semibold uppercase tracking-widest hover:bg-jawa-dark hover:text-jawa-cream transition-colors"
                >Lihat Lokasi</a
              >
            </div>
          </div>

          <!-- Countdown -->
          <div class="mt-20 reveal stagger-3">
            <h4 class="font-serif text-xl text-jawa-gold mb-8">
              Menuju Hari Bahagia
            </h4>
            <div class="flex justify-center gap-2 sm:gap-8">
              <div class="flex flex-col items-center">
                <span
                  class="font-serif text-2xl sm:text-4xl text-jawa-cream"
                  id="days">00</span
                >
                <span
                  class="font-sans text-[10px] sm:text-xs text-jawa-goldLight tracking-widest uppercase mt-2"
                  >Hari</span
                >
              </div>
              <span class="font-serif text-2xl sm:text-4xl text-jawa-gold"
                >:</span
              >
              <div class="flex flex-col items-center">
                <span
                  class="font-serif text-2xl sm:text-4xl text-jawa-cream"
                  id="hours">00</span
                >
                <span
                  class="font-sans text-[10px] sm:text-xs text-jawa-goldLight tracking-widest uppercase mt-2"
                  >Jam</span
                >
              </div>
              <span class="font-serif text-2xl sm:text-4xl text-jawa-gold"
                >:</span
              >
              <div class="flex flex-col items-center">
                <span
                  class="font-serif text-2xl sm:text-4xl text-jawa-cream"
                  id="minutes">00</span
                >
                <span
                  class="font-sans text-[10px] sm:text-xs text-jawa-goldLight tracking-widest uppercase mt-2"
                  >Menit</span
                >
              </div>
              <span class="font-serif text-2xl sm:text-4xl text-jawa-gold"
                >:</span
              >
              <div class="flex flex-col items-center">
                <span
                  class="font-serif text-2xl sm:text-4xl text-jawa-cream"
                  id="seconds">00</span
                >
                <span
                  class="font-sans text-[10px] sm:text-xs text-jawa-goldLight tracking-widest uppercase mt-2"
                  >Detik</span
                >
              </div>
            </div>

            <a
              href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Pernikahan+Risma+%26+Azis&details=Tanpa+mengurangi+rasa+hormat%2C+izinkan+kami+mengundang+Bapak%2FIbu%2FSaudara%2Fi+untuk+hadir+dan+memberikan+doa+restu+pada+acara+pernikahan+kami.&location=Kp.+Binuang+Pasar%2C+Ds.+Binuang+Kec.+Binuang+007%2F002&dates=20261115T010000Z/20261115T060000Z"
              target="_blank"
              class="mt-12 inline-flex items-center gap-2 px-8 py-3 bg-jawa-gold text-jawa-dark font-sans text-xs font-bold uppercase tracking-widest hover:bg-jawa-cream transition-colors"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path></svg
              >
              Simpan ke Kalender
            </a>
          </div>
        </div>
      </section>

      <!-- GALLERY SECTION -->
      <section class="py-24 px-6 text-center" id="gallery">
        <div class="max-w-5xl mx-auto">
          <div class="reveal mb-12">
            <h2 class="font-script text-4xl text-jawa-gold mb-2">
              Our Moments
            </h2>
            <h3 class="font-serif text-3xl text-jawa-cream font-medium">
              Galeri Bahagia
            </h3>
          </div>

          <!-- Bento Grid Gallery 10 Photos -->
