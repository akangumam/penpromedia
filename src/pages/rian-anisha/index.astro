      /* ================== TOAST NOTIFICATION ================== */
      #toast {
        visibility: hidden;
        min-width: max-content;
        background: rgba(253, 244, 231, 0.95);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(201, 164, 92, 0.5);
        color: #2b1a0d;
        text-align: center;
        border-radius: 30px;
        padding: 8px 16px;
        position: fixed;
        z-index: 999999;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%) scale(0.8);
        font-family: var(--font-body), sans-serif;
        font-size: 0.8rem;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        opacity: 0;
        transition:
          transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55),
          opacity 0.4s ease,
          visibility 0.4s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
      }
      #toast.show {
        visibility: visible;
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
      }
      #toast svg {
        color: #2e7d32;
        width: 16px;
        height: 16px;
        flex-shrink: 0;
      }
      .fixed-audio {
        position: fixed;
        bottom: 90px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 50;
        width: 100%;
        max-width: 480px;
        pointer-events: none;
      }
      .audio-btn {
        position: absolute;
        bottom: 0;
        right: 24px;
        width: 48px;
        height: 48px;
        background-color: transparent;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.3s ease, opacity 0.3s ease;
        border: none;
        pointer-events: auto;
      }
      .audio-btn:hover {
        transform: scale(1.1);
      }
      .audio-btn svg, .audio-btn img {
        width: 100%;
        height: 100%;
      }
      .audio-btn.hidden {
        display: none !important;
      }
      .audio-btn.spin-anim svg, .audio-btn.spin-anim img {
        animation: spin-audio 4s linear infinite !important;
      }
      @keyframes spin-audio {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }
