    <!-- Toast Notification HTML & JS -->
    <div id="toast">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="currentColor"
        viewBox="0 0 16 16"
      >
        <path
          d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"
        ></path>
      </svg>
      <span id="toast-message">Berhasil disalin!</span>
    </div>
    <script is:inline>
      function showToast(message) {
        const toast = document.getElementById("toast");
        const toastMsg = document.getElementById("toast-message");
        toastMsg.innerText = message;
        toast.classList.add("show");
        setTimeout(() => {
          toast.classList.remove("show");
        }, 3000);
      }

      window.copyText = function (text, message) {
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard
            .writeText(text)
            .then(() => {
              showToast(message);
            })
            .catch((err) => console.error("Gagal menyalin: ", err));
        } else {
          // Fallback untuk browser lama atau non-HTTPS
          let textArea = document.createElement("textarea");
          textArea.value = text;
          textArea.style.position = "fixed";
          textArea.style.left = "-999999px";
          textArea.style.top = "-999999px";
          document.body.appendChild(textArea);
          textArea.focus();
          textArea.select();
          try {
            document.execCommand("copy");
            showToast(message);
          } catch (err) {
            console.error("Gagal menyalin: ", err);
          }
          textArea.remove();
        }
      };
      // ================== RSVP & GUESTBOOK LOGIC ==================
      document.addEventListener("DOMContentLoaded", () => {
        const SCRIPT_URL = "URL_GAS_ANDA_DISINI";
        const LOCAL_STORAGE_KEY = "guestbook_rian_anisha_real";

        function getStoredEntries() {
          try {
            const raw = localStorage.getItem(LOCAL_STORAGE_KEY);
            if (raw) return JSON.parse(raw);
          } catch (_) {}
          return [];
        }

        function saveStoredEntries(entries) {
          try {
            localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(entries));
          } catch (_) {}
        }

        function updateStatsFromEntries(entries) {
          const el = document.getElementById("rsvp-stats");
          const statHadir = document.getElementById("stat-hadir");
          const statTidak = document.getElementById("stat-tidak");
          if (!el || !statHadir || !statTidak) return;
          let hadir = 0;
          let tidak = 0;
          entries.forEach((e) => {
            if (e.kehadiran === "Hadir") hadir++;
            else tidak++;
          });
          statHadir.textContent = hadir;
          statTidak.textContent = tidak;
          el.style.opacity = "1";
        }

        function timeAgo(isoString) {
          if (!isoString) return "";
          const diff = Date.now() - new Date(isoString).getTime();
          const mins = Math.floor(diff / 60000);
          const hours = Math.floor(diff / 3600000);
          const days = Math.floor(diff / 86400000);
          if (mins < 1) return "Baru saja";
          if (mins < 60) return `${mins} menit lalu`;
          if (hours < 24) return `${hours} jam lalu`;
          if (days < 7) return `${days} hari lalu`;
          return new Date(isoString).toLocaleDateString("id-ID", {
            day: "numeric",
            month: "short",
            year: "numeric",
          });
        }

        function createEntryCard(entry) {
          const isHadir = entry.kehadiran === "Hadir";
          const badgeClass = isHadir ? "badge-hadir" : "badge-tidak";
          
          const card = document.createElement("div");
          card.className = "guest-card";
          
          const safeUcapan = (entry.ucapan || "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
          const safeName = (entry.nama || "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");

          card.innerHTML = `
            <div class="guest-header">
              <div class="guest-name">${safeName}</div>
              <div class="guest-badge ${badgeClass}">${isHadir ? "✅ Hadir" : "❌ Tidak Hadir"}</div>
            </div>
            <div class="guest-msg">${safeUcapan}</div>
            <div class="guest-time">${timeAgo(entry.timestamp)}</div>
          `;
          return card;
        }

        const ITEMS_PER_PAGE = 10;
        let allGuestEntries = [];
        let currentGuestPage = 1;

        function renderGuestPage(page) {
          const list = document.getElementById("guestbook-list");
          const empty = document.getElementById("empty-state");
          const skeleton = document.getElementById("guestbook-skeleton");
          const pagination = document.getElementById("guestbook-pagination");
          const pageInfo = document.getElementById("page-info");
          const prevBtn = document.getElementById("page-prev");
          const nextBtn = document.getElementById("page-next");
          
          if (!list) return;

          if (skeleton) {
            skeleton.classList.add("hidden");
            skeleton.style.display = "none";
          }
          [...list.children].forEach((el) => {
            if (el.id !== "guestbook-skeleton" && el.id !== "empty-state") el.remove();
          });

          if (allGuestEntries.length === 0) {
            if (empty) empty.classList.remove("hidden");
            if (pagination) pagination.style.display = "none";
            return;
          }

          if (empty) empty.classList.add("hidden");

          const totalPages = Math.ceil(allGuestEntries.length / ITEMS_PER_PAGE);
          currentGuestPage = Math.max(1, Math.min(page, totalPages));
          const start = (currentGuestPage - 1) * ITEMS_PER_PAGE;
          const pageEntries = allGuestEntries.slice(start, start + ITEMS_PER_PAGE);

          pageEntries.forEach((entry) => list.appendChild(createEntryCard(entry)));

          if (totalPages > 1) {
            if (pagination) pagination.style.display = "flex";
            if (pageInfo) pageInfo.textContent = `Hal ${currentGuestPage} / ${totalPages}`;
            if (prevBtn) prevBtn.disabled = currentGuestPage === 1;
            if (nextBtn) nextBtn.disabled = currentGuestPage === totalPages;
          } else {
            if (pagination) pagination.style.display = "none";
          }

          list.scrollTop = 0;
        }

        window.guestPrevPage = () => renderGuestPage(currentGuestPage - 1);
        window.guestNextPage = () => renderGuestPage(currentGuestPage + 1);

        async function loadGuestbook() {
          const list = document.getElementById("guestbook-list");
          const skeleton = document.getElementById("guestbook-skeleton");
          const empty = document.getElementById("empty-state");
          if (!list) return;

          try {
            if (SCRIPT_URL === "URL_GAS_ANDA_DISINI") {
              if (skeleton) {
                skeleton.classList.add("hidden");
                skeleton.style.display = "none";
              }
              allGuestEntries = getStoredEntries();
              updateStatsFromEntries(allGuestEntries);
              renderGuestPage(1);
              return;
            }
            if (skeleton) {
              skeleton.classList.remove("hidden");
              skeleton.style.display = "flex";
            }
            if (empty) empty.classList.add("hidden");
            const res = await fetch(`${SCRIPT_URL}?action=getAll`, { cache: "no-store" });
            const json = await res.json();
            allGuestEntries = json.data || [];
            if (skeleton) {
              skeleton.classList.add("hidden");
              skeleton.style.display = "none";
            }
            renderGuestPage(1);
          } catch (err) {
            if (skeleton) {
              skeleton.classList.add("hidden");
              skeleton.style.display = "none";
            }
            allGuestEntries = getStoredEntries();
            updateStatsFromEntries(allGuestEntries);
            renderGuestPage(1);
          }
        }

        async function loadStats() {
          if (SCRIPT_URL === "URL_GAS_ANDA_DISINI") {
            updateStatsFromEntries(allGuestEntries);
            return;
          }
          try {
            const res = await fetch(`${SCRIPT_URL}?action=summary`, { cache: "no-store" });
            const json = await res.json();
            if (json.status === "success" && json.data) {
              const el = document.getElementById("rsvp-stats");
              if (el) {
                document.getElementById("stat-hadir").textContent = json.data.hadir;
                document.getElementById("stat-tidak").textContent = json.data.tidakHadir;
                el.style.opacity = "1";
              }
            }
          } catch (_) {}
        }

        const rsvpForm = document.getElementById("rsvp-form");
        const submitBtn = document.getElementById("rsvp-submit-btn");
        const btnText = document.getElementById("rsvp-btn-text");
        const spinner = document.getElementById("rsvp-spinner");
        const errorBox = document.getElementById("rsvp-error");
        const successBox = document.getElementById("rsvp-success");
        const charCountEl = document.getElementById("char-count");
        const messageInput = document.getElementById("guest-message");

        if (messageInput && charCountEl) {
          messageInput.addEventListener("input", () => {
            const len = messageInput.value.length;
            charCountEl.textContent = `${len} / 500`;
            charCountEl.style.color = len > 450 ? "#ef4444" : "";
          });
        }

        if (rsvpForm) {
          rsvpForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            const namaInput = document.getElementById("rsvp-guest-name");
            const nama = namaInput ? namaInput.value.trim() : "";
            const kehadiranElem = document.querySelector('input[name="kehadiran"]:checked');
            const kehadiran = kehadiranElem ? kehadiranElem.value : "";
            const ucapan = messageInput ? messageInput.value.trim() : "";

            if (!nama || !kehadiran || !ucapan) {
              errorBox.textContent = "Semua field wajib diisi.";
              errorBox.classList.remove("hidden");
              errorBox.style.display = "block";
              return;
            }
            errorBox.style.display = "none";
            successBox.style.display = "none";

            submitBtn.disabled = true;
            btnText.textContent = "Mengirim…";
            spinner.classList.remove("hidden");
            spinner.style.display = "inline-block";

            try {
              if (SCRIPT_URL === "URL_GAS_ANDA_DISINI") {
                await new Promise((r) => setTimeout(r, 600));
                
                successBox.style.display = "block";
                rsvpForm.reset();
                if (charCountEl) charCountEl.textContent = "0 / 500";

                const newEntry = {
                  nama,
                  kehadiran,
                  ucapan,
                  timestamp: new Date().toISOString(),
                };
                allGuestEntries.unshift(newEntry);
                saveStoredEntries(allGuestEntries);
                updateStatsFromEntries(allGuestEntries);
                renderGuestPage(1);

                setTimeout(() => (successBox.style.display = "none"), 4000);
              } else {
                const res = await fetch(SCRIPT_URL, {
                  method: "POST",
                  headers: { "Content-Type": "text/plain" },
                  body: JSON.stringify({ nama, kehadiran, ucapan }),
                });
                const json = await res.json();

                if (json.status === "success") {
                  successBox.style.display = "block";
                  rsvpForm.reset();
                  if (charCountEl) charCountEl.textContent = "0 / 500";

                  const newEntry = {
                    nama,
                    kehadiran,
                    ucapan,
                    timestamp: new Date().toISOString(),
                  };
                  allGuestEntries.unshift(newEntry);
                  saveStoredEntries(allGuestEntries);
                  renderGuestPage(1);

                  setTimeout(() => (successBox.style.display = "none"), 4000);
                  loadStats();
                } else {
                  errorBox.textContent = json.message || "Terjadi kesalahan. Coba lagi.";
                  errorBox.style.display = "block";
                }
              }
            } catch (err) {
              console.error("Submit error:", err);
              errorBox.textContent = "Gagal terhubung ke server.";
              errorBox.style.display = "block";
            } finally {
              submitBtn.disabled = false;
              btnText.textContent = "Kirim Pesan";
              spinner.style.display = "none";
            }
          });
        }

        setTimeout(() => {
          loadGuestbook();
          loadStats();
        }, 1000);
      });
    </script>

    <script is:inline>
      var ytPlayer;
      var ytReady = false;
      var isMusicPlaying = false;
      var wantToPlay = false;

      function onYouTubeIframeAPIReady() {
        ytPlayer = new YT.Player("youtube-player", {
          height: "1",
          width: "1",
          videoId: "ZeFpigRaXbI",
          playerVars: {
            autoplay: 0,
            controls: 0,
            disablekb: 1,
            loop: 1,
            playsinline: 1,
            playlist: "ZeFpigRaXbI",
          },
          events: {
            onReady: function(event) {
              ytReady = true;
              if (wantToPlay) {
                ytPlayer.playVideo();
                isMusicPlaying = true;
                const audioBtn = document.getElementById("audio-btn");
                if (audioBtn) audioBtn.classList.add("spin-anim");
              }
            },
          },
        });
      }

      document.addEventListener("DOMContentLoaded", () => {
        const audioBtn = document.getElementById("audio-btn");
        if (audioBtn) {
          audioBtn.addEventListener("click", () => {
            if (!ytReady || !ytPlayer) return;
            
            if (isMusicPlaying) {
              ytPlayer.pauseVideo();
              isMusicPlaying = false;
              audioBtn.classList.remove("spin-anim");
              audioBtn.style.opacity = "0.7";
            } else {
              ytPlayer.playVideo();
              isMusicPlaying = true;
              audioBtn.classList.add("spin-anim");
              audioBtn.style.opacity = "1";
            }
          });
        }
      });
    </script>
  </body>
</html>
