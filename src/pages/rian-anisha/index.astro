---
/**
 * Undangan Pernikahan Digital
 */
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Wedding of Rian Firdaus & Anisha Indah Rahmadina</title>

    <!-- Primary SEO Meta Tags -->
    <meta
      name="description"
      content="Undangan Pernikahan Rian & Anisha. Kami mengundang Bapak/Ibu/Saudara/i untuk hadir pada Minggu, 20 Desember 2026."
    />

    <!-- Open Graph / Facebook / WhatsApp Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://penpromedia.web.id/rian-anisha/" />
    <meta property="og:site_name" content="Penpromedia" />
    <meta property="og:title" content="The Wedding of Rian Firdaus & Anisha Indah Rahmadina" />
    <meta
      property="og:description"
      content="Undangan Pernikahan Rian & Anisha. Kami mengundang Bapak/Ibu/Saudara/i untuk hadir pada Minggu, 20 Desember 2026."
    />
    <meta
      property="og:image"
      content="https://penpromedia.web.id/assets/img/rian-anisha/og-banner.jpg"
    />
    <meta
      property="og:image:url"
      content="https://penpromedia.web.id/assets/img/rian-anisha/og-banner.jpg"
    />
    <meta
      property="og:image:secure_url"
      content="https://penpromedia.web.id/assets/img/rian-anisha/og-banner.jpg"
    />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Wedding of Rian Firdaus & Anisha Indah Rahmadina" />

    <!-- Twitter / X Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://penpromedia.web.id/rian-anisha/" />
    <meta name="twitter:title" content="The Wedding of Rian Firdaus & Anisha Indah Rahmadina" />
    <meta
      name="twitter:description"
      content="Undangan Pernikahan Rian & Anisha. Kami mengundang Bapak/Ibu/Saudara/i untuk hadir pada Minggu, 20 Desember 2026."
    />
    <meta
      name="twitter:image"
      content="https://penpromedia.web.id/assets/img/rian-anisha/og-banner.jpg"
    />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Inter:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <style>
      /* CSS Reset & Variables */
      :root {
        --primary: #8a6c42; /* Javanese Gold */
        --primary-dark: #664d2b;
        --text-main: #333;
        --text-light: #f5f5f5;
        --bg-main: #faf8f5; /* Warm off-white */

        --font-heading: "Playfair Display", serif;
        --font-body: "Inter", sans-serif;
        --font-script: "Great Vibes", cursive;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: var(--font-body);
        background-color: #5c4a38;
        background-image: url("/undangan1/assets/JAWA-BACKGROUND.jpg");
        background-size: cover;
        background-position: center;
        background-attachment: fixed; /* Stay fixed, tidak ikut scroll */
        color: var(--text-dark);
        margin: 0;
        padding: 0;
        overflow-x: hidden;
      }

      html.no-scroll,
      body.no-scroll {
        overflow: hidden !important;
        height: 100vh !important;
      }

      .hidden {
        display: none !important;
      }

      #app-container {
        width: 100%;
        max-width: 480px;
        min-height: 100vh;
        position: relative;
        margin: 0 auto; /* Center on desktop */
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.8);
        overflow-x: hidden;
      }

      h1,
      h2,
      h3,
      h4,
      .title,
      .pre-title,
      .date {
        font-family: var(--font-heading);
        font-weight: 600;
      }

      /* ================== PRELOADER ================== */
      .preloader {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: #000;
        z-index: 99999;
        display: flex;
        justify-content: center;
        align-items: center;
        transition:
          opacity 0.8s ease,
          visibility 0.8s ease;
      }

      .preloader-content {
        text-align: center;
        color: #fff;
      }

      .preloader-subtitle {
        font-family: Arial, sans-serif;
        font-size: 1rem;
        margin-bottom: 0.3rem;
      }

      .preloader-title {
        font-family: Arial, sans-serif;
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 1.5rem;
      }

      .preloader-percentage {
        font-family: "Times New Roman", Times, serif;
        font-size: 1.4rem;
        font-weight: bold;
      }

      /* ================== COVER SECTION ================== */
      .cover {
        position: fixed;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100%;
        max-width: 480px;
        height: 100vh;
        height: 100dvh;
        background-color: #3b2b20;
        background-image:
          linear-gradient(
            to bottom,
            rgba(59, 43, 32, 0.85) 0%,
            rgba(59, 43, 32, 0.2) 25%,
            rgba(59, 43, 32, 0.2) 65%,
            rgba(59, 43, 32, 0.95) 100%
          ),
          url("/assets/img/rian-anisha/cover.webp");
        background-size: cover;
        background-position: center 20%;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        text-align: center;
        transition: transform 1.2s cubic-bezier(0.77, 0, 0.175, 1);
        padding: 4vh 1rem 6vh 1rem;
      }

      .cover.slide-up {
        transform: translate(-50%, -100%);
      }

      .cover-pattern {
        display: none; /* Removed pattern for clean look */
      }

      .cover-top {
        position: relative;
        z-index: 2;
        color: #fff;
        width: 100%;
      }

      .cover-top .pre-title {
        font-family: var(--font-script);
        font-size: 1.8rem;
        font-weight: 400;
        margin-bottom: 0.2rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
      }

      .cover-top .title {
        font-family: var(--font-heading);
        font-size: clamp(1.5rem, 7vw, 2.2rem);
        white-space: nowrap;
        margin-bottom: 0.5rem;
        letter-spacing: 2px;
        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.8);
      }

      .cover-top .date-minimalist {
        font-family: var(--font-body);
        font-size: 0.9rem;
        letter-spacing: 4px;
        font-weight: 300;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.6);
      }

      .cover-bottom {
        position: relative;
        z-index: 2;
        color: #fff;
        width: 100%;
      }

      .guest-info {
        margin-bottom: 1.5rem;
      }

      .guest-info p {
        font-family: var(--font-body);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
        letter-spacing: 1px;
      }

      .guest-info h3 {
        font-family: var(--font-heading);
        font-size: 1.8rem;
        text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.6);
      }

      /* Button */
      .btn-primary {
        background: linear-gradient(135deg, #c5a059 0%, #a67c33 100%);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.4);
        padding: 10px 28px;
        font-size: 0.95rem;
        border-radius: 30px;
        cursor: pointer;
        font-family: var(--font-body);
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        gap: 10px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
      }

      .btn-primary:hover {
        background: linear-gradient(135deg, #a67c33 0%, #c5a059 100%);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
      }

      /* ================== MAIN CONTENT ================== */
      .main-content {
        position: relative;
        min-height: 100vh;
      }

      .main-content.hidden {
        display: none;
      }

      /* Video Background */
      .video-bg-container {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100%;
        max-width: 480px;
        height: 100vh;
        height: 100dvh;
        z-index: -1;
        background-color: var(--bg-main);
        background-image: url("/undangan1/assets/JAWA-BACKGROUND.jpg");
        background-size: cover;
        background-position: center;
      }

      .bg-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      /* Hero Section */
      .hero-section {
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: var(--text-light);
        padding: 2rem;
      }

      .motif-atas,
      .motif-bawah {
        position: absolute;
        width: 100%;
        max-width: 400px;
        left: 50%;
        transform: translateX(-50%);
      }

      .motif-atas {
        top: 0;
      }

      .motif-bawah {
        bottom: 0;
      }

      .motif-atas img,
      .motif-bawah img {
        width: 100%;
        opacity: 0.8;
      }

      .hero-content {
        position: absolute;
        top: 42%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        z-index: 2;
        padding: 0 2rem;
      }

      .hero-content .pre-title {
        font-family: var(--font-script);
        font-size: 1.8rem;
        font-weight: 400;
        margin-bottom: 0.2rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
      }

      .hero-content .title {
        font-family: var(--font-heading);
        font-size: 2.4rem;
        color: #dcb36d;
        margin-bottom: 0.8rem;
        letter-spacing: 2px;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
        line-height: 1.1;
      }

      .hero-content .date-minimalist {
        font-family: var(--font-heading);
        font-size: 0.85rem;
        letter-spacing: 4px;
        font-weight: 600;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.4);
      }

      .gunungan-wrapper {
        margin-bottom: 2rem;
      }

      .gunungan-img {
        width: 150px;
        animation: float 4s ease-in-out infinite;
      }

      /* ================== COUPLE SECTION ================== */
      .couple-section {
        padding: 4rem 1.5rem;
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: center;
      }

      .couple-container {
        background-color: rgba(253, 251, 247, 0.65);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        background-image: url("/undangan1/assets/JAWA-PATTERN.png");
        background-size: 150px;
        background-repeat: repeat;
        background-blend-mode: soft-light;
        border: 4px solid #c9a45c;
        border-radius: 200px;
        padding: 0 1.5rem 4rem 1.5rem;
        text-align: center;
        max-width: 420px;
        width: 100%;
        box-shadow:
          0 25px 50px -12px rgba(0, 0, 0, 0.5),
          0 0 30px rgba(201, 164, 92, 0.3);
        position: relative;
        overflow: hidden;
      }

      .couple-top-ornament {
        width: calc(100% + 3rem);
        max-width: none;
        display: block;
        margin: 0 -1.5rem 1rem -1.5rem;
        object-fit: cover;
      }

      .gunungan-small-wrapper {
        margin-top: -10.5rem;
        margin-bottom: 0.5rem;
        display: flex;
        justify-content: center;
        position: relative;
        z-index: 3;
      }

      .gunungan-small {
        width: 60px !important;
        max-width: 60px !important;
        height: auto !important;
        opacity: 0.85;
      }

      .couple-bottom-ornament {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        max-width: none;
        display: block;
        object-fit: cover;
      }

      .couple-pretitle {
        font-family: var(--font-script);
        font-size: 2.2rem;
        color: var(--text-dark);
        margin: 0.5rem 0 1.5rem 0;
        line-height: 1.2;
      }

      .couple-desc-new {
        font-family: var(--font-body);
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 3rem;
        line-height: 1.6;
        padding: 0 1rem;
      }

      .couple-card-new {
        margin-bottom: 4rem;
        position: relative;
      }

      .couple-photo-frame {
        position: relative;
        width: 200px;
        margin: 0 auto 1.5rem auto;
      }

      /* Arch frame menggunakan CSS murni */
      .couple-photo-arch {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        border-radius: 120px; /* Atas dan bawah membulat (pill shape) */
        border: 3px solid #c9a45c;
        box-shadow: 0 6px 20px rgba(138, 108, 66, 0.25);
        display: block;
        z-index: 2;
        object-fit: cover;
        object-position: center 20%;
        background-color: #e8dfd0;
      }

      .couple-photo-frame::before {
        content: "";
        display: block;
        padding-top: 150%; /* 2:3 aspect ratio untuk portrait */
      }

      /* Wayang gunungan — sisi kiri tengah frame */
      .deco-wayang {
        position: absolute;
        left: -45px;
        top: 20%;
        width: 140px;
        z-index: 1; /* Di belakang frame */
        pointer-events: none;
      }

      /* Bunga — sudut kanan bawah */
      .deco-flower {
        position: absolute;
        right: -75px;
        bottom: -45px;
        width: 160px;
        z-index: 3; /* Di depan frame */
        pointer-events: none;
        transform: rotate(-5deg);
      }

      /* Mirror layout untuk mempelai pria */
      .groom .deco-wayang {
        left: auto;
        right: -45px;
      }
      .groom .deco-flower {
        right: auto;
        left: -85px;
        bottom: -20px;
        transform: rotate(15deg);
      }

      .name-script-large {
        font-family: var(--font-script);
        font-size: 2.5rem;
        color: var(--text-dark);
        margin: 1.5rem 0 0.5rem 0;
      }

      .name-serif-full {
        font-family: var(--font-heading);
        font-size: 1rem;
        color: var(--text-dark);
        letter-spacing: 1px;
        margin: 0 0 0.5rem 0;
        text-transform: uppercase;
        font-weight: 600;
      }

      .parents-new {
        font-family: var(--font-body);
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text-dark);
        line-height: 1.5;
        margin-bottom: 1rem;
      }

      .btn-instagram {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: #b59864;
        color: #fff;
        padding: 8px 24px;
        border-radius: 20px;
        text-decoration: none;
        font-size: 0.75rem;
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
        box-shadow: none;
      }

      .btn-instagram:hover {
        background-color: #927a4d;
        transform: translateY(-2px);
        color: #fff;
      }

      .ampersand {
        font-family: var(--font-heading);
        font-size: 4rem;
        color: var(--text-dark);
        margin: 1rem 0 2rem 0;
      }

      /* Desktop layout dihilangkan agar tetap dalam mode mobile view */

      /* ================== ANIMATIONS ================== */
      @keyframes float {
        0% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-15px);
        }
        100% {
          transform: translateY(0px);
        }
      }

      .animate-up {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
      }

      .animate-up.visible {
        opacity: 1;
        transform: translateY(0);
      }

      .delay-1 {
        transition-delay: 0.2s;
      }
      .delay-2 {
        transition-delay: 0.4s;
      }
      .delay-3 {
        transition-delay: 0.6s;
      }
      /* ================== GALLERY SECTION ================== */
      .gallery-section {
        padding: 2rem 1.5rem;
        background-color: var(--bg-main);
        text-align: center;
      }

      .gallery-slider {
        width: 100%;
        padding-top: 1rem;
        padding-bottom: 3rem;
        overflow: hidden;
      }

      .gallery-slider .swiper-slide {
        background-position: center;
        background-size: cover;
        width: 80%;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
      }

      .gallery-slider img {
        display: block;
        width: 100%;
        aspect-ratio: 3/4;
        object-fit: cover;
        border-radius: 12px;
      }

      .swiper-pagination-bullet-active {
        background: var(--accent-gold) !important;
      }
    </style>
    <style is:global>
      /* ================== SAVE THE DATE SECTION ================== */
      .savethedate-section {
        padding: 3.5rem 1.5rem;
        margin: 2rem 1.5rem;
        background-color: rgba(43, 31, 22, 0.95);
        background-image: url("/undangan1/assets/JAWA-PATTERN.png");
        background-size: 100px;
        background-blend-mode: color-burn;
        border-radius: 12px;
        text-align: center;
        color: #fff;
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
      }
      .savethedate-title {
        font-family: var(--font-heading), serif !important;
        font-size: 1.6rem !important;
        color: #c9a45c !important;
        margin-bottom: 2rem !important;
        font-weight: 500 !important;
        letter-spacing: 1px !important;
        text-shadow: none !important;
      }
      .countdown-wrapper {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 0.8rem !important;
        margin-bottom: 2.5rem !important;
      }
      .countdown-item {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        min-width: 50px !important;
      }
      .cd-num {
        font-size: 2.2rem !important;
        font-weight: 700 !important;
        color: #fff !important;
        font-family: var(--font-heading), serif !important;
        line-height: 1.1 !important;
      }
      .cd-label {
        font-size: 0.65rem !important;
        font-weight: 600 !important;
        color: #c9a45c !important;
        letter-spacing: 1.5px !important;
        margin-top: 0.4rem !important;
        text-transform: uppercase !important;
      }
      .cd-separator {
        font-size: 1.8rem !important;
        font-weight: 600 !important;
        color: #c9a45c !important;
        margin-top: -1.2rem !important;
      }
      .calendar-btn {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 0.6rem !important;
        background-color: #c9a45c !important;
        color: #2b1f16 !important;
        padding: 0.8rem 1.5rem !important;
        border-radius: 4px !important;
        font-size: 0.85rem !important;
        font-weight: 700 !important;
        letter-spacing: 1px !important;
        text-decoration: none !important;
        width: 100% !important;
        max-width: 300px !important;
        transition: background-color 0.3s !important;
      }
      .calendar-btn:hover {
        background-color: #dfb96e !important;
      }

      /* ================== ACARA SECTION ================== */
      .acara-section {
        padding: 3rem 1.5rem;
        background-color: var(--bg-main);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
      }
      .acara-section-title {
        font-family: var(--font-heading), serif;
        font-size: 1.4rem;
        color: var(--primary);
        text-align: center;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 0;
      }
      .acara-divider {
        width: 60px;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          var(--primary),
          transparent
        );
        margin: -0.5rem auto 0.5rem;
      }
      .acara-prolog {
        font-family: var(--font-body), sans-serif;
        font-size: 0.85rem;
        color: #555;
        text-align: center;
        line-height: 1.6;
        margin: 0 auto 1.5rem;
        font-weight: 500;
      }

      /* ── Kartu Acara ── */
      .event-card {
        width: 100%;
        border-radius: 20px;
        background-image: url("/undangan1/assets/JAWA-BACKGROUND.jpg");
        background-size: cover;
        background-position: center;
        padding: 10px;
        box-shadow:
          0 16px 50px rgba(0, 0, 0, 0.4),
          inset 0 1px 0 rgba(255, 255, 255, 0.08);
        position: relative;
        overflow: hidden;
      }

      /* Inner card – krem dengan pola batik lembut */
      .event-card-inner {
        border-radius: 13px;
        background: rgba(253, 244, 231, 0.75);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        overflow: hidden;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.6rem 1.5rem 1.5rem;
        text-align: center;
        gap: 0;
      }

      /* Konten tengah */
      .event-type-title {
        font-family: var(--font-script), cursive;
        font-size: 2.2rem;
        color: #2b1a0d;
        font-weight: 400;
        line-height: 1.1;
        margin-bottom: 0.8rem;
        white-space: nowrap;
        position: relative;
        z-index: 1;
      }
      .event-day {
        font-family: var(--font-heading), serif;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: #4a3020;
        margin-bottom: 0.15rem;
        position: relative;
        z-index: 1;
      }
      .event-date {
        font-family: var(--font-heading), serif;
        font-size: 1.25rem;
        font-weight: 700;
        color: #2b1a0d;
        letter-spacing: 1px;
        text-transform: uppercase;
        white-space: nowrap;
        margin-bottom: 0.15rem;
        position: relative;
        z-index: 1;
      }
      .event-time {
        font-family: var(--font-body), sans-serif;
        font-size: 0.82rem;
        color: #6b5030;
        margin-bottom: 0;
        position: relative;
        z-index: 1;
      }
      .event-sep {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #c9a45c;
        margin: 0.9rem auto;
        position: relative;
        z-index: 1;
      }
      .event-location-icon {
        color: #c9a45c;
        margin-bottom: 0.3rem;
        line-height: 1;
        position: relative;
        z-index: 1;
      }
      .event-venue {
        font-family: var(--font-heading), serif;
        font-size: 0.95rem;
        font-weight: 700;
        color: #2b1a0d;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        white-space: nowrap;
        margin-bottom: 0.35rem;
        position: relative;
        z-index: 1;
      }
      .event-address {
        font-family: var(--font-body), sans-serif;
        font-size: 0.76rem;
        color: #7a6040;
        line-height: 1.65;
        margin-bottom: 0;
        position: relative;
        z-index: 1;
      }
      .event-maps-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin-top: 1.1rem;
        padding: 0.6rem 1.5rem;
        background: #c9a45c;
        color: #2b1a0d;
        font-family: var(--font-body), sans-serif;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.3px;
        border-radius: 50px;
        text-decoration: none;
        transition:
          background 0.25s,
          transform 0.2s,
          box-shadow 0.25s;
        box-shadow: 0 3px 12px rgba(201, 164, 92, 0.4);
        position: relative;
        z-index: 1;
      }
      .event-maps-btn:hover {
        background: #dfb96e;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(201, 164, 92, 0.5);
      }

      /* ================== GALLERY SECTION (BENTO GRID) ================== */
      .gallery-section {
        padding: 4rem 1.5rem;
        background-color: #31231a;
        background-image: url("/undangan1/assets/JAWA-PATTERN.png");
        background-size: 150px;
        background-blend-mode: color-burn;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .gallery-section-title {
        font-family: var(--font-heading), serif;
        font-size: 1.6rem;
        color: #c9a45c;
        text-align: center;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
      }
      .gallery-divider {
        width: 60px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #c9a45c, transparent);
        margin: 0 auto 2.5rem;
      }
      .bento-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        width: 100%;
        max-width: 380px;
      }
      .bento-item {
        position: relative;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
      }
      .bento-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 20%;
        display: block;
        transition: transform 0.4s ease;
      }
      .bento-item:hover img {
        transform: scale(1.05);
      }
      /* Bento Layout sizing */
      .bento-1 {
        grid-column: span 2;
        aspect-ratio: 4 / 5;
      }
      .bento-2,
      .bento-3,
      .bento-4,
      .bento-5 {
        grid-column: span 1;
        aspect-ratio: 1 / 1;
      }
      .bento-6 {
        grid-column: span 2;
        aspect-ratio: 4 / 5;
      }
      .bento-6 img {
        object-position: center top;
      }

      /* ================== LOVE STORY SECTION ================== */
      .lovestory-section {
        padding: 4rem 0;
        background-color: var(--bg-main);
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .lovestory-card {
        width: 100%;
        border-radius: 0;
        background-image: url("/undangan1/assets/JAWA-BACKGROUND.jpg");
        background-size: cover;
        background-position: center;
        padding: 3rem 1.2rem;
        box-shadow:
          0 16px 50px rgba(0, 0, 0, 0.4),
          inset 0 1px 0 rgba(255, 255, 255, 0.08);
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .lovestory-gunungan {
        width: 60px;
        margin-bottom: 1rem;
        position: relative;
        z-index: 2;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
      }
      .lovestory-title {
        font-family: var(--font-script), cursive;
        font-size: 3rem;
        color: #2b1a0d;
        font-weight: 400;
        margin-bottom: 2rem;
        text-align: center;
        position: relative;
        z-index: 2;
      }
      .lovestory-timeline {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        width: 100%;
        position: relative;
        z-index: 2;
      }
      .timeline-item {
        background: rgba(
          253,
          244,
          231,
          0.85
        ); /* Cukup solid agar teks mudah dibaca */
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
      }
      .timeline-year {
        font-family: var(--font-heading), serif;
        font-size: 1.3rem;
        font-weight: 700;
        color: #2b1a0d;
        margin-bottom: 0.8rem;
      }
      .timeline-text {
        font-family: var(--font-body), sans-serif;
        font-size: 0.85rem;
        color: #4a3020;
        line-height: 1.6;
        margin-bottom: 0;
      }

      /* ================== LOVE GIFT SECTION ================== */
      .lovegift-section {
        padding: 4rem 1.5rem;
        background-color: #31231a;
        background-image: url("/undangan1/assets/JAWA-PATTERN.png");
        background-size: 150px;
        background-blend-mode: color-burn;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      .lovegift-icon {
        width: 50px;
        height: 50px;
        margin-bottom: 0.5rem;
        color: #fff;
      }
      .lovegift-title {
        font-family: var(--font-script), cursive;
        font-size: 3rem;
        color: #fff;
        font-weight: 400;
        margin-bottom: 1rem;
      }
      .lovegift-subtitle {
        font-family: var(--font-body), sans-serif;
        font-size: 0.9rem;
        color: #fff;
        line-height: 1.6;
        margin-bottom: 2.5rem;
        max-width: 400px;
      }
      .lovegift-card {
        width: 100%;
        max-width: 400px;
        background: #fdf4e7;
        border-radius: 16px;
        border: 2px solid #c9a45c;
        padding: 2rem 1.5rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        text-align: center;
      }
      .bank-info {
        position: relative;
        margin-bottom: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      .bank-logo {
        position: static;
        height: 38px;
        width: auto;
        margin: 0 auto 1.2rem auto;
        display: block;
      }
      .bank-details {
        font-family: var(--font-body), sans-serif;
        font-size: 0.95rem;
        color: #2b1a0d;
        line-height: 1.7;
        padding-right: 0;
        text-align: center;
        width: 100%;
      }
      .bank-details strong {
        font-weight: 700;
      }
      .copy-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        padding: 0.8rem;
        background: #a98d5c;
        color: #fff;
        font-family: var(--font-body), sans-serif;
        font-size: 0.8rem;
        font-weight: 700;
        border: none;
        border-radius: 20px;
        cursor: pointer;
        transition:
          background 0.2s,
          transform 0.2s;
        margin-top: 1.2rem;
      }
      .copy-btn:hover {
        background: #c9a45c;
        transform: translateY(-2px);
      }
      .gift-divider {
        width: 100%;
        height: 1px;
        background: #ccc;
        margin: 2rem 0;
      }
      .kado-info {
        text-align: center;
      }
      .kado-icon {
        width: 45px;
        height: 45px;
        color: #a98d5c;
        margin-bottom: 0.8rem;
      }
      .kado-title {
        font-family: var(--font-heading), serif;
        font-size: 1.2rem;
        color: #2b1a0d;
        font-weight: 700;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
      }
      .kado-details {
        font-family: var(--font-body), sans-serif;
        font-size: 0.85rem;
        color: #2b1a0d;
        line-height: 1.6;
        margin-bottom: 1.5rem;
      }
      .kado-details strong {
        font-size: 0.95rem;
        display: block;
        margin-bottom: 0.2rem;
      }

      /* ================== RSVP & GUESTBOOK ================== */
      .rsvp-section {
        padding: 4rem 1.5rem;
        background-color: var(--bg-main);
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .rsvp-container {
        width: 100%;
        max-width: 500px;
        background: rgba(253, 244, 231, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(201, 164, 92, 0.3);
        border-radius: 20px;
        padding: 2.5rem 1.5rem;
        box-shadow: 0 15px 40px rgba(0,0,0,0.1);
        text-align: center;
      }
      .rsvp-title {
        font-family: var(--font-script), cursive;
        font-size: 3rem;
        color: var(--primary);
        font-weight: 400;
        margin-bottom: 0.5rem;
      }
      .rsvp-subtitle {
        font-family: var(--font-body), sans-serif;
        font-size: 0.9rem;
        color: #4a3020;
        line-height: 1.5;
        margin-bottom: 2rem;
      }
      .rsvp-form {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        text-align: left;
      }
      .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .form-group label {
        font-family: var(--font-body), sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        color: #2b1a0d;
      }
      .form-group input[type="text"],
      .form-group textarea {
        width: 100%;
        padding: 12px 16px;
        border-radius: 12px;
        border: 1px solid #d4c4b7;
        background: #fff;
        font-family: var(--font-body), sans-serif;
        font-size: 0.9rem;
        color: #2b1a0d;
        transition: border-color 0.2s, box-shadow 0.2s;
        resize: none;
      }
      .form-group input[type="text"]:focus,
      .form-group textarea:focus {
        outline: none;
        border-color: #c9a45c;
        box-shadow: 0 0 0 3px rgba(201,164,92,0.2);
      }
      .radio-group {
        display: flex;
        gap: 1rem;
      }
      .radio-label {
        flex: 1;
        cursor: pointer;
        position: relative;
      }
      .radio-label input {
        position: absolute;
        opacity: 0;
        cursor: pointer;
      }
      .radio-custom {
        display: block;
        text-align: center;
        padding: 10px;
        background: #fff;
        border: 1px solid #d4c4b7;
        border-radius: 10px;
        font-family: var(--font-body), sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        color: #4a3020;
        transition: all 0.2s;
      }
      .radio-label input:checked ~ .radio-custom {
        background: #c9a45c;
        color: #fff;
        border-color: #c9a45c;
      }
      .char-counter {
        font-family: var(--font-body), sans-serif;
        font-size: 0.75rem;
        color: #888;
        text-align: right;
      }
      .rsvp-alert {
        padding: 10px 15px;
        border-radius: 10px;
        font-family: var(--font-body), sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        text-align: center;
      }
      .rsvp-alert.error {
        background: #ffebee;
        color: #c62828;
        border: 1px solid #ef9a9a;
      }
      .rsvp-alert.success {
        background: #e8f5e9;
        color: #2e7d32;
        border: 1px solid #a5d6a7;
      }
      .rsvp-btn {
        width: 100%;
        padding: 12px;
        background: #a98d5c;
        color: #fff;
        font-family: var(--font-body), sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: background 0.2s, transform 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 0.5rem;
      }
      .rsvp-btn:hover {
        background: #c9a45c;
        transform: translateY(-2px);
      }
      .rsvp-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
        transform: none;
      }
      .spinner {
        width: 18px;
        height: 18px;
        border: 2px solid rgba(255,255,255,0.3);
        border-radius: 50%;
        border-top-color: #fff;
        animation: spin 1s ease-in-out infinite;
      }
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
      .rsvp-stats-box {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        background: #fff;
        border-radius: 15px;
        padding: 1.2rem;
        margin-top: 2rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        opacity: 0;
        transition: opacity 0.5s;
      }
      .stat-item {
        text-align: center;
      }
      .stat-num {
        font-family: var(--font-heading), serif;
        font-size: 2rem;
        font-weight: 700;
        color: #c9a45c;
        line-height: 1;
      }
      .stat-label {
        font-family: var(--font-body), sans-serif;
        font-size: 0.8rem;
        color: #4a3020;
        font-weight: 600;
        margin-top: 0.3rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .stat-divider {
        width: 1px;
        height: 40px;
        background: #d4c4b7;
      }
      .guestbook-container {
        margin-top: 2rem;
        text-align: left;
      }
      .guestbook-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-height: 500px;
        overflow-y: auto;
        padding-right: 5px;
      }
      .guestbook-list::-webkit-scrollbar {
        width: 6px;
      }
      .guestbook-list::-webkit-scrollbar-track {
        background: rgba(0,0,0,0.05);
        border-radius: 10px;
      }
      .guestbook-list::-webkit-scrollbar-thumb {
        background: rgba(201,164,92,0.5);
        border-radius: 10px;
      }
      .guest-card {
        background: #fff;
        border: 1px solid rgba(201,164,92,0.2);
        border-radius: 12px;
        padding: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
      }
      .guest-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.5rem;
      }
      .guest-name {
        font-family: var(--font-body), sans-serif;
        font-size: 0.9rem;
        font-weight: 700;
        color: #2b1a0d;
      }
      .guest-badge {
        font-family: var(--font-body), sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 20px;
      }
      .badge-hadir {
        background: #e8f5e9;
        color: #2e7d32;
        border: 1px solid #a5d6a7;
      }
      .badge-tidak {
        background: #ffebee;
        color: #c62828;
        border: 1px solid #ef9a9a;
      }
      .guest-msg {
        font-family: var(--font-body), sans-serif;
        font-size: 0.85rem;
        color: #4a3020;
        line-height: 1.5;
        margin-bottom: 0.5rem;
        word-wrap: break-word;
      }
      .guest-time {
        font-family: var(--font-body), sans-serif;
        font-size: 0.7rem;
        color: #888;
      }
      .empty-state {
        text-align: center;
        color: #a98d5c;
        font-family: var(--font-body), sans-serif;
        font-size: 0.85rem;
        padding: 2rem 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
      }
      .pagination-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1.5rem;
      }
      .page-btn {
        background: transparent;
        border: 1px solid #c9a45c;
        color: #a98d5c;
        padding: 6px 12px;
        border-radius: 8px;
        font-family: var(--font-body), sans-serif;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
      }
      .page-btn:hover:not(:disabled) {
        background: #c9a45c;
        color: #fff;
      }
      .page-btn:disabled {
        opacity: 0.3;
        cursor: not-allowed;
      }
      .page-info {
        font-family: var(--font-body), sans-serif;
        font-size: 0.8rem;
        color: #4a3020;
      }
      .skeleton-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .skeleton-wrapper.hidden {
        display: none !important;
      }
      .empty-state.hidden {
        display: none !important;
      }
      .skeleton-card {
        width: 100%;
        height: 90px;
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        border-radius: 12px;
        animation: skeleton-loading 1.5s infinite;
      }
      @keyframes skeleton-loading {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
      }

      /* ================== FOOTER ================== */
      .footer-section {
        background-color: #2b1a0d;
        color: #fff;
        text-align: center;
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 4rem 1.5rem;
        overflow: hidden;
      }
      .footer-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
        z-index: 0;
        filter: brightness(0.85);
        transform: scale(1.25) translateY(-5%);
        transform-origin: center top;
      }
      .footer-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          to bottom,
          rgba(43, 26, 13, 0.88) 0%,
          rgba(43, 26, 13, 0.55) 28%,
          rgba(43, 26, 13, 0.1) 42%,
          rgba(43, 26, 13, 0.1) 75%,
          rgba(43, 26, 13, 0.88) 98%
        );
        z-index: 1;
      }
      .footer-content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        flex-grow: 1;
        width: 100%;
      }
      .footer-top {
        margin-top: 0.5rem;
      }
      .footer-middle {
        margin-top: 1.25rem;
        margin-bottom: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .footer-bottom {
        margin-top: auto;
        margin-bottom: 0.5rem;
      }
      .footer-title {
        font-family: 'Great Vibes', cursive !important;
        font-size: 2.5rem;
        font-weight: 400;
        white-space: nowrap;
        color: #fff;
        margin-bottom: 0;
        text-shadow: 2px 2px 8px rgba(0,0,0,0.8);
      }
      .footer-text {
        font-family: var(--font-body), sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        line-height: 1.6;
        color: #fff;
        max-width: 600px;
        margin: 0.5rem auto 0 auto;
        text-shadow: 1px 1px 6px rgba(0,0,0,0.8);
      }
      .footer-subtitle {
        font-family: var(--font-body), sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 0.5rem;
        text-shadow: 1px 1px 6px rgba(0,0,0,0.8);
      }
      .footer-names {
        font-family: 'Great Vibes', cursive !important;
        font-size: 2.8rem;
        color: #fff;
        text-shadow: 2px 2px 8px rgba(0,0,0,0.8);
      }
      .footer-credit {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.8rem;
        margin-top: 2rem;
      }
      .footer-credit p {
        font-family: var(--font-body), sans-serif;
        font-size: 0.8rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
        text-shadow: 1px 1px 4px rgba(0,0,0,0.8);
      }
      .footer-logo {
        height: 25px;
        object-fit: contain;
        filter: brightness(0) invert(1) drop-shadow(1px 1px 4px rgba(0,0,0,0.8));
        opacity: 0.95;
        transition: transform 0.3s;
