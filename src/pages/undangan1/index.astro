---
/**
 * Undangan Pernikahan Digital — Motion Parallax Theme
 * Penpromedia
 */
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Undangan Pernikahan — Parallax</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Jost:wght@300;400;500;600&family=Pinyon+Script&display=swap"
      rel="stylesheet"
    />
    
    <style>
      /* Base font families */
      .font-sans { font-family: 'Jost', sans-serif; }
      .font-serif { font-family: 'Cinzel', serif; }
      .font-script { font-family: 'Pinyon Script', cursive; }

      /* Parallax layers */
      .parallax-wrapper {
        position: relative;
        height: 100vh;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #1a1a1a;
      }
      
      .parallax-layer {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        will-change: transform;
      }

      /* Content on top */
      .parallax-content {
        position: relative;
        z-index: 30;
        text-align: center;
        color: white;
      }
      
      /* Next section to allow scrolling */
      .content-section {
        position: relative;
        z-index: 40;
        background-color: #fcfaf8;
        min-height: 100vh;
        padding: 4rem 1rem;
        text-align: center;
      }
    </style>
  </head>
  
  <body class="bg-[#fcfaf8] text-gray-800 antialiased overflow-x-hidden">
    
    <!-- PARALLAX HERO SECTION -->
    <header class="parallax-wrapper relative bg-[#2a201b] border-[12px] border-[#4a3525]" id="hero-section">
      
      <!-- Layer 1: Couple Photo Background (Moves slowest) -->
      <img 
        src="/assets/img/undangan1/couple-cover.jpg" 
        alt="Couple Cover" 
        class="parallax-layer z-0 object-cover opacity-80" 
        id="layer-photo" 
        data-speed="0.25"
      />

      <!-- Gradient Overlay at bottom for text readability -->
      <div class="absolute inset-0 z-10 bg-gradient-to-t from-[#2a201b] via-[#2a201b]/40 to-transparent pointer-events-none"></div>

      <!-- Layer 2: Content (Moves medium speed) -->
      <div class="parallax-content z-20 flex flex-col items-center justify-between h-full py-16 w-full" id="layer-text" data-speed="0.5">
        
        <!-- Top Section -->
        <div class="mt-4">
          <p class="font-script text-3xl md:text-5xl text-white mb-2 drop-shadow-md">The Wedding of</p>
          <h1 class="font-serif text-2xl md:text-4xl text-white font-bold tracking-widest drop-shadow-md">
            RISMA &amp; AZIS
          </h1>
        </div>

        <!-- Bottom Section -->
        <div class="mb-4">
          <p class="font-sans text-sm text-gray-200 mb-1">Kepada Yth.</p>
          <h2 class="font-serif text-2xl text-white font-bold mb-6 drop-shadow-md">Nama Tamu</h2>
          
          <button type="button" class="bg-[#b38b59] hover:bg-[#9a7649] text-white px-8 py-3 rounded-full font-sans text-sm tracking-wide transition-colors flex items-center justify-center gap-2 mx-auto shadow-lg border border-[#d4b589]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Buka Undangan
          </button>
        </div>

      </div>
      
    </header>

    <!-- KONTEN SELANJUTNYA -->
    <section class="content-section">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-serif text-3xl mb-6 text-[#1a1a1a]">Section Selanjutnya</h2>
        <p class="font-sans text-gray-600">
          Scroll ke atas dan ke bawah untuk melihat efek Parallax pada Cover Halaman. 
        </p>
        
        <div class="mt-20 space-y-10">
          <div class="h-64 bg-gray-100 rounded-lg flex items-center justify-center">Konten 1</div>
          <div class="h-64 bg-gray-100 rounded-lg flex items-center justify-center">Konten 2</div>
          <div class="h-64 bg-gray-100 rounded-lg flex items-center justify-center">Konten 3</div>
        </div>
      </div>
    </section>

    <!-- SCRIPT UNTUK PARALLAX -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const photoLayer = document.getElementById("layer-photo");
        const textLayer = document.getElementById("layer-text");

        // Fungsi Update Parallax
        const updateParallax = () => {
          const scrollY = window.scrollY;
          
          window.requestAnimationFrame(() => {
            if (photoLayer) {
              const speed = parseFloat(photoLayer.getAttribute("data-speed") || "0");
              photoLayer.style.transform = `translateY(${scrollY * speed}px)`;
            }
            if (textLayer) {
              const speed = parseFloat(textLayer.getAttribute("data-speed") || "0");
              textLayer.style.transform = `translateY(${scrollY * speed}px)`;
            }
          });
        };

        // Pasang event listener untuk scroll
        window.addEventListener("scroll", updateParallax, { passive: true });
      });
    </script>
  </body>
</html>
