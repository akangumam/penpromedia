---
/**
 * Global Link Generator & Guestbook Manager - Penpromedia
 * URL: /buku-tamu/?id=klien-id
 */
---
<!doctype html>
<html lang="id" class="bg-[#0a0a0a]">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Buku Tamu & Link Generator - Penpromedia</title>
  
  <link rel="icon" type="image/png" href="/assets/img/penpromedia_favicon.png" />

  <!-- Google Fonts: Jost (Penpromedia Brand) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com" is:inline></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              gold: '#cfa670',
              goldHover: '#b58f5c',
              bg: '#0a0a0a',
              surface: '#141414',
              surfaceElevated: '#1a1a1a',
            }
          },
          fontFamily: {
            sans: ['Jost', 'sans-serif'],
          }
        }
      }
    };
  </script>

  <style is:inline>
    /* Toast Animation */
    .toast-enter { transform: translateY(0); opacity: 1; }
    .toast-leave { transform: translateY(-20px); opacity: 0; }
    
    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: #0a0a0a; }
    ::-webkit-scrollbar-thumb { background: #333; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #cfa670; }

    /* Skeleton pulse */
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    .animate-pulse-slow {
      animation: pulse 1.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
  </style>
</head>
<body class="font-sans text-white/80 min-h-screen flex flex-col antialiased selection:bg-brand-gold selection:text-black">

  <!-- Header -->
  <header class="py-6 border-b border-white/10 bg-brand-bg/80 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <!-- Logo -->
        <img src="/assets/img/penpromedia_logo.png" alt="Penpromedia Logo" class="h-10 sm:h-12 object-contain" />
        
        <!-- Divider -->
        <div class="h-10 w-[1px] bg-white/20 hidden sm:block"></div>
        
        <div class="text-left hidden sm:block">
          <h1 class="text-xl font-bold tracking-wider text-white uppercase">Portal Undangan</h1>
          <p class="text-xs tracking-widest text-brand-gold uppercase mt-0.5">Sistem Manajemen Penpromedia</p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div id="client-badge" class="hidden px-4 py-1.5 rounded-full border border-brand-gold/30 bg-brand-gold/10 text-brand-gold text-xs font-medium tracking-wide">
          Klien: <span id="display-client-id" class="font-bold ml-1 text-white"></span>
        </div>
        
        <!-- Settings button (only visible when logged in) -->
        <button 
          id="btn-settings-toggle"
          type="button"
          onclick="toggleSettingsModal()"
          class="hidden px-3 py-1.5 rounded-lg border border-white/10 text-xs text-white/60 hover:text-white hover:border-brand-gold/50 transition-colors flex items-center gap-1.5"
          title="Pengaturan Google Sheets API"
        >
          <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          <span class="hidden sm:inline">API</span>
        </button>

        <!-- Lock / Logout button -->
        <button 
          id="btn-logout"
          type="button"
          onclick="logoutAdmin()"
          class="hidden px-3 py-1.5 rounded-lg border border-red-500/20 text-xs text-red-400 hover:text-white hover:bg-red-500/20 transition-colors flex items-center gap-1.5"
          title="Kunci Dashboard"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
          <span class="hidden sm:inline">Kunci</span>
        </button>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-6xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 sm:py-10 flex flex-col justify-center">
    
    <!-- State: Error ID Missing -->
    <div id="error-state" class="hidden text-center py-20">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-red-900/20 text-red-500 mb-6 border border-red-900/50">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      </div>
      <h2 class="text-2xl font-bold text-white mb-3">ID Klien Tidak Ditemukan</h2>
      <p class="text-white/60 max-w-md mx-auto">Parameter ID klien pada URL diperlukan untuk mengakses buku tamu dan link generator. <br/><br/>Contoh format URL yang benar:<br/><code class="bg-brand-surface px-3 py-1 rounded text-brand-gold border border-white/10 mt-2 inline-block">/buku-tamu/?id=rian-anisha</code></p>
    </div>

    <!-- State: Login / Locked Screen -->
    <div id="login-state" class="hidden max-w-md mx-auto w-full py-8 sm:py-12">
      <div class="bg-brand-surface rounded-2xl border border-white/10 p-6 sm:p-10 shadow-2xl relative overflow-hidden text-center">
        <!-- Decorative blur background -->
        <div class="absolute top-0 right-0 w-48 h-48 bg-brand-gold/10 blur-[80px] pointer-events-none"></div>

        <div class="w-16 h-16 rounded-full bg-brand-gold/10 text-brand-gold border border-brand-gold/20 flex items-center justify-center mx-auto mb-5 shadow-[0_0_20px_rgba(207,166,112,0.15)]">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
        </div>

        <h2 class="text-xl sm:text-2xl font-bold text-white tracking-wide mb-1">Akses Terkunci</h2>
        <p class="text-xs text-white/50 mb-6">Portal Manajemen Klien: <span id="login-client-id" class="text-brand-gold font-semibold font-mono"></span></p>

        <form id="login-form" onsubmit="handleLogin(event)" class="space-y-4">
          <div class="relative text-left">
            <label class="block text-xs font-medium text-white/70 mb-2">Kata Sandi Admin</label>
            <div class="relative">
              <input 
                id="login-password-input"
                type="password"
                placeholder="Masukkan kata sandi..."
                autocomplete="current-password"
                class="w-full bg-black/60 border border-white/15 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-brand-gold transition-colors placeholder:text-white/30"
                required
              />
              <button 
                type="button" 
                onclick="togglePasswordVisibility('login-password-input', this)"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-white/40 hover:text-white transition-colors p-1"
                tabindex="-1"
                title="Lihat / Sembunyikan Sandi"
              >
                <svg class="w-4 h-4 eye-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
              </button>
            </div>
            <p id="login-error-msg" class="text-xs text-red-400 mt-2 hidden flex items-center gap-1.5 font-medium">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Kata sandi tidak valid!
            </p>
          </div>

          <button 
            id="btn-submit-login"
            type="submit"
            class="w-full bg-brand-gold hover:bg-brand-goldHover text-black font-semibold py-3 px-6 rounded-xl transition-all active:scale-[0.98] flex items-center justify-center gap-2 text-sm shadow-[0_4px_20px_rgba(207,166,112,0.2)]"
          >
            <span id="btn-login-text">Buka Dashboard</span>
            <svg id="btn-login-spinner" class="animate-spin w-4 h-4 text-black hidden" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
          </button>
        </form>
      </div>
    </div>

    <!-- State: Main Content (Unlocked) -->
    <div id="main-state" class="hidden">

      <!-- Navigation Tabs -->
      <div class="flex items-center border-b border-white/10 mb-8 gap-2 sm:gap-4 overflow-x-auto pb-1">
        <button 
          id="tab-btn-generator" 
          type="button" 
          onclick="switchTab('generator')"
          class="flex items-center gap-2 py-3 px-5 font-semibold text-sm rounded-t-lg border-b-2 border-brand-gold text-brand-gold bg-brand-surface transition-all whitespace-nowrap"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
          1. Sebar Undangan (Link Generator)
        </button>

        <button 
          id="tab-btn-ucapan" 
          type="button" 
          onclick="switchTab('ucapan')"
          class="flex items-center gap-2 py-3 px-5 font-semibold text-sm rounded-t-lg border-b-2 border-transparent text-white/50 hover:text-white hover:bg-white/5 transition-all whitespace-nowrap"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
          2. Kelola Ucapan Tamu
          <span id="tab-ucapan-badge" class="text-xs bg-white/10 text-white/70 px-2 py-0.5 rounded-full font-mono">0</span>
        </button>
      </div>

      <!-- ========================================== -->
      <!-- TAB 1: SEBAR UNDANGAN (LINK GENERATOR)      -->
      <!-- ========================================== -->
      <div id="tab-content-generator">
        <div class="flex flex-col lg:flex-row gap-8 items-start">
          
          <!-- Sidebar / Guidelines -->
          <aside class="w-full lg:w-1/3 bg-brand-surface rounded-xl border border-white/5 p-6 shadow-2xl">
            <h3 class="font-semibold text-white text-lg mb-6 tracking-wide flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Panduan Penggunaan
            </h3>
            
            <div class="space-y-4">
              <div class="p-4 rounded-lg bg-black/40 border border-white/5">
                <h4 class="text-sm font-medium text-brand-gold mb-2">1. Masukkan Nama Tamu</h4>
                <p class="text-xs text-white/60 leading-relaxed">Ketik atau <i>copy-paste</i> nama tamu di kolom yang disediakan. Pastikan setiap nama berada di baris baru (dipisah dengan Enter).</p>
              </div>
              
              <div class="p-4 rounded-lg bg-black/40 border border-white/5">
                <h4 class="text-sm font-medium text-brand-gold mb-2">2. Pilih Teks Pengantar</h4>
                <p class="text-xs text-white/60 leading-relaxed">Pilih <i>template</i> pesan yang sesuai. Sistem akan otomatis mengganti tulisan <code class="text-white bg-black px-1 rounded">[nama-tamu]</code> dan <code class="text-white bg-black px-1 rounded">[link-undangan]</code>.</p>
              </div>

              <div class="p-4 rounded-lg bg-black/40 border border-white/5">
                <h4 class="text-sm font-medium text-brand-gold mb-2">3. Generate & Bagikan</h4>
                <p class="text-xs text-white/60 leading-relaxed">Klik tombol Generate. Anda bisa langsung mengirim pesan ke tamu satu per satu menggunakan tombol WhatsApp yang tersedia.</p>
              </div>
            </div>
          </aside>

          <!-- Main Generator Form -->
          <div class="w-full lg:w-2/3">
            <div class="bg-brand-surface rounded-xl border border-white/5 p-6 sm:p-8 shadow-2xl relative overflow-hidden">
              <div class="absolute top-0 right-0 w-64 h-64 bg-brand-gold/5 blur-[100px] pointer-events-none"></div>

              <div class="mb-6 relative z-10">
                <label class="block font-medium text-white text-sm mb-3">Daftar Nama Tamu</label>
                <textarea 
                  id="guest-names-input" 
                  rows="6" 
                  class="w-full bg-black/50 border border-white/10 rounded-lg p-4 text-sm text-white focus:outline-none focus:border-brand-gold focus:ring-1 focus:ring-brand-gold resize-y transition-colors placeholder:text-white/20"
                  placeholder="Bapak Budi & Keluarga&#10;Siti Aisyah&#10;John Doe"
                ></textarea>
              </div>

              <div class="mb-6 relative z-10">
                <div class="flex items-center justify-between mb-3">
                  <label class="block font-medium text-white text-sm">Opsi Teks Pengantar</label>
                  <select id="template-selector" onchange="changeTemplate()" class="bg-black/50 border border-white/10 rounded-md py-1.5 px-3 text-xs text-white/80 focus:outline-none focus:border-brand-gold hover:border-white/30 transition-colors cursor-pointer">
                    <option value="formal">Undangan Formal (Default)</option>
                    <option value="santai">Undangan Santai / Akrab</option>
                    <option value="tanpa_gelar">Undangan Tanpa Gelar</option>
                  </select>
                </div>

                <textarea 
                  id="message-template" 
                  rows="8" 
                  class="w-full bg-black/50 border border-white/10 rounded-lg p-4 text-sm text-white/80 focus:outline-none focus:border-brand-gold focus:ring-1 focus:ring-brand-gold resize-y transition-colors leading-relaxed"
                ></textarea>
              </div>

              <div class="relative z-10 pt-2 border-t border-white/5">
                <button 
                  type="button"
                  onclick="generateLinks()"
                  class="w-full sm:w-auto bg-brand-gold hover:bg-brand-goldHover text-black font-semibold py-3 px-8 rounded-lg transition-all active:scale-95 flex items-center justify-center gap-2"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                  Generate Link Tamu
                </button>
              </div>

            </div>

            <!-- Generated Results Table -->
            <div id="results-container" class="mt-8 bg-brand-surface rounded-xl border border-white/5 shadow-2xl overflow-hidden hidden">
              <div class="bg-black/40 px-6 py-4 border-b border-white/5 flex items-center justify-between">
                <h4 class="font-semibold text-white tracking-wide">Hasil Generate</h4>
                <span id="total-guests" class="text-xs bg-brand-gold/10 text-brand-gold px-2 py-1 rounded border border-brand-gold/20">0 Tamu</span>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm whitespace-nowrap">
                  <thead>
                    <tr class="bg-black/20 border-b border-white/5">
                      <th class="p-4 font-medium text-white/40 w-12 text-center text-xs tracking-wider">#</th>
                      <th class="p-4 font-medium text-white/60 text-xs tracking-wider">NAMA TAMU</th>
                      <th class="p-4 font-medium text-white/60 text-right pr-6 text-xs tracking-wider">AKSI</th>
                    </tr>
                  </thead>
                  <tbody id="results-tbody" class="divide-y divide-white/5">
                    <!-- Generated rows -->
                  </tbody>
                </table>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- TAB 2: KELOLA UCAPAN TAMU (GUESTBOOK MGR)   -->
      <!-- ========================================== -->
      <div id="tab-content-ucapan" class="hidden">
        
        <!-- Controls Bar -->
        <div class="bg-brand-surface rounded-xl border border-white/5 p-4 sm:p-6 mb-6 shadow-xl flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
          <div class="flex-1 relative">
            <svg class="w-5 h-5 text-white/40 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <input 
              id="search-comments-input"
              type="text"
              oninput="filterComments()"
              placeholder="Cari nama tamu atau kata dalam ucapan..."
              class="w-full bg-black/50 border border-white/10 rounded-lg pl-11 pr-4 py-2.5 text-sm text-white focus:outline-none focus:border-brand-gold transition-colors placeholder:text-white/30"
            />
          </div>

          <div class="flex items-center gap-3 justify-between md:justify-end">
            <span id="comments-stat-count" class="text-xs text-white/60 font-mono">
              Memuat data...
            </span>

            <button 
              type="button"
              onclick="loadComments(true)"
              class="px-4 py-2.5 bg-black/40 hover:bg-black/60 border border-white/10 rounded-lg text-xs font-semibold text-white/80 hover:text-white hover:border-brand-gold/40 transition-colors flex items-center gap-2"
              title="Perbarui daftar ucapan"
            >
              <svg id="refresh-icon" class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
              Refresh
            </button>
          </div>
        </div>

        <!-- Skeleton Loading State -->
        <div id="comments-skeleton" class="space-y-4">
          <div class="bg-brand-surface rounded-xl border border-white/5 p-6 animate-pulse-slow">
            <div class="flex items-center justify-between mb-4">
              <div class="h-4 w-32 bg-white/10 rounded"></div>
              <div class="h-3 w-20 bg-white/10 rounded"></div>
            </div>
            <div class="h-3 w-full bg-white/5 rounded mb-2"></div>
            <div class="h-3 w-3/4 bg-white/5 rounded"></div>
          </div>
          <div class="bg-brand-surface rounded-xl border border-white/5 p-6 animate-pulse-slow">
            <div class="flex items-center justify-between mb-4">
              <div class="h-4 w-40 bg-white/10 rounded"></div>
              <div class="h-3 w-24 bg-white/10 rounded"></div>
            </div>
            <div class="h-3 w-5/6 bg-white/5 rounded mb-2"></div>
            <div class="h-3 w-2/3 bg-white/5 rounded"></div>
          </div>
        </div>

        <!-- Empty State -->
        <div id="comments-empty" class="hidden bg-brand-surface rounded-xl border border-white/5 p-12 text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brand-gold/10 text-brand-gold mb-4 border border-brand-gold/20">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Belum Ada Ucapan Masuk</h3>
          <p class="text-white/50 text-sm max-w-md mx-auto">Ucapan dan doa restu dari para tamu undangan akan otomatis muncul di sini setelah tamu mengirimkannya melalui form undangan.</p>
        </div>

        <!-- Comments List Container -->
        <div id="comments-list" class="space-y-4">
          <!-- Dynamically populated -->
        </div>

      </div>

    </div>
  </main>

  <!-- ========================================== -->
  <!-- MODAL: HAPUS UCAPAN CONFIRMATION           -->
  <!-- ========================================== -->
  <div id="modal-delete" class="fixed inset-0 z-[120] bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
