  <!-- Toast Notification -->
  <div id="toast" class="fixed bottom-10 left-1/2 -translate-x-1/2 z-[200] bg-brand-gold text-black px-6 py-3 rounded-full shadow-[0_0_20px_rgba(207,166,112,0.3)] text-sm font-semibold transition-all duration-300 toast-leave pointer-events-none flex items-center gap-2">
    <span id="toast-msg">Copied!</span>
  </div>

  <script is:inline>
    // State variables
    let clientId = '';
    let baseUrl = '';
    let activeTab = 'generator';
    let allComments = [];
    let pendingDeleteTarget = null;
    let savedAdminPassword = '';

    // Master SCRIPT_URL: default or from localStorage
    const STORAGE_KEY_GAS_URL = 'penpromedia_master_gas_url';
    const DEFAULT_SCRIPT_URL = 'URL_GAS_ANDA_DISINI';
    const DEFAULT_ADMIN_PASSWORD = 'penpromedia2026';

    function getScriptUrl() {
      const saved = localStorage.getItem(STORAGE_KEY_GAS_URL);
      return saved && saved.trim().length > 0 ? saved.trim() : DEFAULT_SCRIPT_URL;
    }

    const TEMPLATES = {
      formal: `Bismillahirahmanirrahim.
Assalamu'alaikum Warahmatullahi Wabarakatuh.

Tanpa mengurangi rasa hormat, izinkan kami mengundang Bapak/Ibu/Saudara/i:

*[nama-tamu]*

Untuk hadir dan memberikan doa restu pada acara pernikahan kami.

Detail acara dan informasi lengkap dapat dilihat melalui tautan undangan berikut:
[link-undangan]

Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir di hari bahagia kami.

Wassalamu'alaikum Warahmatullahi Wabarakatuh.`,

      santai: `Halo *[nama-tamu]*! 👋

Semoga kabarmu selalu baik ya. 
Dengan penuh rasa syukur dan bahagia, kami bermaksud mengundang kamu untuk hadir di momen spesial pernikahan kami.

Silakan buka link undangan di bawah ini untuk melihat detail acaranya:
[link-undangan]

Kehadiran dan doa restumu akan menjadi kado terindah bagi kami. Ditunggu kedatangannya ya! 😊`,

      tanpa_gelar: `Bismillahirahmanirrahim.
Assalamu'alaikum Warahmatullahi Wabarakatuh.

Tanpa mengurangi rasa hormat, izinkan kami mengundang:

*[nama-tamu]*

Untuk hadir dan memberikan doa restu pada acara pernikahan kami.

Informasi lengkap mengenai acara dapat dilihat melalui tautan undangan berikut:
[link-undangan]

Kehadiran Anda sangat berarti bagi kami. Terima kasih atas perhatian dan doa restunya.

Wassalamu'alaikum Warahmatullahi Wabarakatuh.`
    };

    // Secret key for signature
    const SECRET_KEY = "PENPROMEDIA_SECRET_2026";

    async function generateSignature(name) {
      const msgUint8 = new TextEncoder().encode(name.trim().toLowerCase() + SECRET_KEY);
      const hashBuffer = await crypto.subtle.digest('SHA-256', msgUint8);
      const hashArray = Array.from(new Uint8Array(hashBuffer));
      const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
      return hashHex.substring(0, 10);
    }

    // ==========================================
    // INITIALIZATION & AUTH CHECK
    // ==========================================
    document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      clientId = urlParams.get('id');

      if (!clientId) {
        document.getElementById('error-state').classList.remove('hidden');
        return;
      }

      // Base URL with trailing slash to avoid 301 redirect
      baseUrl = `${window.location.origin}/${clientId}/`;

      // Set label ID di login card
      const loginClientLabel = document.getElementById('login-client-id');
      if (loginClientLabel) loginClientLabel.textContent = clientId;

      // Check existing session
      const sessionKey = `penpromedia_admin_auth_${clientId}`;
      const cachedPass = sessionStorage.getItem(sessionKey);

      if (cachedPass) {
        savedAdminPassword = cachedPass;
        unlockDashboard(false);
      } else {
        // Show login state
        document.getElementById('login-state').classList.remove('hidden');
        const passInput = document.getElementById('login-password-input');
        if (passInput) passInput.focus();
      }
    });

    // ==========================================
    // LOGIN & LOGOUT WORKFLOW
    // ==========================================
    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      if (!input) return;
      if (input.type === 'password') {
        input.type = 'text';
        btn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"></path></svg>`;
      } else {
        input.type = 'password';
        btn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>`;
      }
    }

    async function handleLogin(e) {
      e.preventDefault();
      const passInput = document.getElementById('login-password-input');
      const errorMsg = document.getElementById('login-error-msg');
      const btnText = document.getElementById('btn-login-text');
      const spinner = document.getElementById('btn-login-spinner');
      const submitBtn = document.getElementById('btn-submit-login');

      const pass = (passInput.value || '').trim();
      if (!pass) return;

      errorMsg.classList.add('hidden');
      submitBtn.disabled = true;
      btnText.textContent = 'Memverifikasi...';
      spinner.classList.remove('hidden');

      try {
        const scriptUrl = getScriptUrl();

        // 1. Validasi lokal (password standar)
        if (pass === DEFAULT_ADMIN_PASSWORD) {
          savedAdminPassword = pass;
          sessionStorage.setItem(`penpromedia_admin_auth_${clientId}`, pass);
          unlockDashboard(true);
          return;
        }

        // 2. Jika bukan password default dan URL GAS tersedia, cek ke API GAS
        if (scriptUrl !== DEFAULT_SCRIPT_URL) {
          const res = await fetch(scriptUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain' },
            body: JSON.stringify({
              action: 'delete',
              id: clientId,
              timestamp: 'verify-only',
              password: pass
            })
          });
          const json = await res.json();

          if (json && json.message === 'Password salah!') {
            errorMsg.classList.remove('hidden');
            passInput.focus();
          } else {
            savedAdminPassword = pass;
            sessionStorage.setItem(`penpromedia_admin_auth_${clientId}`, pass);
            unlockDashboard(true);
          }
        } else {
          errorMsg.classList.remove('hidden');
          passInput.focus();
        }
      } catch (err) {
        console.error('Error saat verifikasi login:', err);
        errorMsg.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = 'Buka Dashboard';
        spinner.classList.add('hidden');
      }
    }

    function unlockDashboard(showToastFeedback = true) {
      // Hide login state, show main state
      document.getElementById('login-state').classList.add('hidden');
      document.getElementById('main-state').classList.remove('hidden');
      document.getElementById('client-badge').classList.remove('hidden');
      document.getElementById('display-client-id').textContent = clientId;
      document.getElementById('btn-settings-toggle').classList.remove('hidden');
      document.getElementById('btn-logout').classList.remove('hidden');

      // Initialize generator template
      document.getElementById('message-template').value = TEMPLATES.formal;

      // Initialize Settings input
      const gasUrlInput = document.getElementById('input-gas-url');
      if (gasUrlInput) {
        gasUrlInput.value = localStorage.getItem(STORAGE_KEY_GAS_URL) || '';
      }

      // Pre-load comments count for badge
      loadComments(false);

      if (showToastFeedback) {
        showToast('Akses dashboard berhasil dibuka!');
      }
    }

    function logoutAdmin() {
      sessionStorage.removeItem(`penpromedia_admin_auth_${clientId}`);
      savedAdminPassword = '';

      document.getElementById('main-state').classList.add('hidden');
      document.getElementById('client-badge').classList.add('hidden');
      document.getElementById('btn-settings-toggle').classList.add('hidden');
      document.getElementById('btn-logout').classList.add('hidden');
      document.getElementById('login-state').classList.remove('hidden');

      const passInput = document.getElementById('login-password-input');
      if (passInput) {
        passInput.value = '';
        passInput.focus();
      }

      showToast('Dashboard telah dikunci kembali');
    }

    // ==========================================
    // TAB SWITCHING LOGIC
    // ==========================================
    function switchTab(tab) {
      activeTab = tab;
      const tabGen = document.getElementById('tab-content-generator');
      const tabUcp = document.getElementById('tab-content-ucapan');
      const btnGen = document.getElementById('tab-btn-generator');
      const btnUcp = document.getElementById('tab-btn-ucapan');

      if (tab === 'generator') {
        tabGen.classList.remove('hidden');
        tabUcp.classList.add('hidden');

        btnGen.className = 'flex items-center gap-2 py-3 px-5 font-semibold text-sm rounded-t-lg border-b-2 border-brand-gold text-brand-gold bg-brand-surface transition-all whitespace-nowrap';
        btnUcp.className = 'flex items-center gap-2 py-3 px-5 font-semibold text-sm rounded-t-lg border-b-2 border-transparent text-white/50 hover:text-white hover:bg-white/5 transition-all whitespace-nowrap';
      } else {
        tabGen.classList.add('hidden');
        tabUcp.classList.remove('hidden');

        btnUcp.className = 'flex items-center gap-2 py-3 px-5 font-semibold text-sm rounded-t-lg border-b-2 border-brand-gold text-brand-gold bg-brand-surface transition-all whitespace-nowrap';
        btnGen.className = 'flex items-center gap-2 py-3 px-5 font-semibold text-sm rounded-t-lg border-b-2 border-transparent text-white/50 hover:text-white hover:bg-white/5 transition-all whitespace-nowrap';

        // Load fresh comments when switching to Tab 2
        loadComments(true);
      }
    }

    // ==========================================
    // TAB 1: GENERATOR LOGIC
    // ==========================================
    function changeTemplate() {
      const selector = document.getElementById('template-selector');
      const textarea = document.getElementById('message-template');
      textarea.value = TEMPLATES[selector.value];
    }

    async function generateLinks() {
      const namesInput = document.getElementById('guest-names-input').value;
      const template = document.getElementById('message-template').value;
      const tbody = document.getElementById('results-tbody');
      const container = document.getElementById('results-container');
      const totalBadge = document.getElementById('total-guests');
      
      const names = namesInput.split('\n').map(n => n.trim()).filter(n => n.length > 0);
      
      if (names.length === 0) {
        showToast('Masukkan minimal satu nama tamu', true);
        return;
      }

      tbody.innerHTML = '';

      for (let index = 0; index < names.length; index++) {
        const name = names[index];
        const sig = await generateSignature(name);
        const link = `${baseUrl}?to=${encodeURIComponent(name)}&sig=${sig}`;
        
        let message = template.replace(/\[nama-tamu\]/gi, name);
        message = message.replace(/\[link-undangan\]/gi, link);
        const waLink = `https://wa.me/?text=${encodeURIComponent(message)}`;

        const tr = document.createElement('tr');
        tr.className = 'hover:bg-white/[0.02] transition-colors group';
        tr.id = `row-${index}`;
        tr.dataset.rawLink = link;
        tr.dataset.rawMessage = message;

        tr.innerHTML = `
          <td class="p-4 text-center text-white/30 text-xs font-mono">${index + 1}</td>
          <td class="p-4 font-medium text-white/90">${name}</td>
          <td class="p-4 text-right pr-6">
            <div class="flex items-center justify-end gap-2 opacity-80 group-hover:opacity-100 transition-opacity">
              <button type="button" onclick="window.open('${link}', '_blank')" class="w-8 h-8 rounded border border-white/10 text-white/70 flex items-center justify-center hover:bg-white/10 hover:text-white transition-colors" title="Buka Link">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              </button>
              <button type="button" onclick="copyData('link', ${index})" class="w-8 h-8 rounded border border-white/10 text-brand-gold flex items-center justify-center hover:bg-brand-gold/10 hover:border-brand-gold/30 transition-colors" title="Copy Link">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
              </button>
              <button type="button" onclick="copyData('message', ${index})" class="w-8 h-8 rounded border border-white/10 text-white flex items-center justify-center hover:bg-white/10 hover:border-white/30 transition-colors" title="Copy Pesan Lengkap">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
              </button>
              <button type="button" onclick="window.open('${waLink}', '_blank')" class="w-8 h-8 rounded border border-white/10 text-green-400 flex items-center justify-center hover:bg-green-400/10 hover:border-green-400/30 transition-colors" title="Kirim via WhatsApp">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </button>
              <button type="button" onclick="removeRow(${index})" class="w-8 h-8 rounded border border-white/10 text-red-400 flex items-center justify-center hover:bg-red-400/10 hover:border-red-400/30 transition-colors" title="Hapus dari List">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              </button>
            </div>
          </td>
        `;
        tbody.appendChild(tr);
      }

      totalBadge.textContent = `${names.length} Tamu`;
      container.classList.remove('hidden');
      
      setTimeout(() => {
        container.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 100);
      showToast('Tautan berhasil digenerate!');
    }

    function removeRow(index) {
      const row = document.getElementById(`row-${index}`);
      if (row) row.remove();
      
      const tbody = document.getElementById('results-tbody');
      const totalBadge = document.getElementById('total-guests');
      const remaining = tbody.children.length;
      
      totalBadge.textContent = `${remaining} Tamu`;
      
      if (remaining === 0) {
        document.getElementById('results-container').classList.add('hidden');
      }
    }

    function copyData(type, index) {
      const row = document.getElementById(`row-${index}`);
      if(!row) return;

      const dataToCopy = type === 'link' ? row.dataset.rawLink : row.dataset.rawMessage;
      
      navigator.clipboard.writeText(dataToCopy).then(() => {
        showToast(type === 'link' ? 'Link berhasil disalin!' : 'Pesan berhasil disalin!');
      }).catch(() => {
        showToast('Gagal menyalin text', true);
      });
    }

    // ==========================================
    // TAB 2: GUESTBOOK MANAGEMENT LOGIC
    // ==========================================
    function formatTime(isoString) {
      if (!isoString) return '';
      try {
        const date = new Date(isoString);
        return date.toLocaleDateString('id-ID', {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });
      } catch (_) {
        return isoString;
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    async function loadComments(showFeedback = false) {
      const skeleton = document.getElementById('comments-skeleton');
      const emptyState = document.getElementById('comments-empty');
      const listContainer = document.getElementById('comments-list');
      const badge = document.getElementById('tab-ucapan-badge');
      const statCount = document.getElementById('comments-stat-count');
      const refreshIcon = document.getElementById('refresh-icon');

      if (refreshIcon) refreshIcon.classList.add('animate-spin');
      if (skeleton && activeTab === 'ucapan') skeleton.classList.remove('hidden');

      const scriptUrl = getScriptUrl();

      try {
        if (scriptUrl === DEFAULT_SCRIPT_URL) {
          // Read from LocalStorage fallback
          const localKey = `guestbook_${clientId}`;
          const raw = localStorage.getItem(localKey);
          allComments = raw ? JSON.parse(raw) : [];
        } else {
          // Fetch from Google Apps Script with clientId
          const res = await fetch(`${scriptUrl}?action=getAll&id=${encodeURIComponent(clientId)}`, {
            cache: 'no-store'
          });
          const json = await res.json();
          allComments = (json && json.status === 'success' && Array.isArray(json.data)) ? json.data : [];
        }

        // Update badge
        badge.textContent = allComments.length;

        // Render comments
        renderCommentsList(allComments);

        if (showFeedback) {
          showToast(`Berhasil memuat ${allComments.length} ucapan`);
        }
      } catch (err) {
        console.warn('Gagal load dari GAS, mencoba fallback localStorage:', err);
        const localKey = `guestbook_${clientId}`;
        const raw = localStorage.getItem(localKey);
        allComments = raw ? JSON.parse(raw) : [];
        badge.textContent = allComments.length;
        renderCommentsList(allComments);
        if (showFeedback) {
          showToast('Dimuat dari cache lokal', false);
        }
      } finally {
        if (skeleton) skeleton.classList.add('hidden');
        if (refreshIcon) refreshIcon.classList.remove('animate-spin');
      }
    }

    function renderCommentsList(items) {
      const emptyState = document.getElementById('comments-empty');
      const listContainer = document.getElementById('comments-list');
      const statCount = document.getElementById('comments-stat-count');

      statCount.textContent = `Total: ${items.length} Ucapan`;

      if (items.length === 0) {
        emptyState.classList.remove('hidden');
        listContainer.innerHTML = '';
        return;
      }

      emptyState.classList.add('hidden');
      listContainer.innerHTML = '';

      items.forEach((item, index) => {
        const card = document.createElement('div');
        card.className = 'bg-brand-surface rounded-xl border border-white/5 p-5 sm:p-6 shadow-xl hover:border-white/10 transition-colors flex flex-col sm:flex-row items-start justify-between gap-4 group';

        const safeName = escapeHtml(item.nama);
        const safeUcapan = escapeHtml(item.ucapan);
        const initial = safeName.trim().charAt(0).toUpperCase() || '?';
        const formattedDate = formatTime(item.timestamp);

        card.innerHTML = `
          <div class="flex items-start gap-4 flex-1">
            <div class="w-10 h-10 rounded-full bg-brand-gold/15 border border-brand-gold/30 text-brand-gold flex items-center justify-center font-bold text-sm flex-shrink-0 mt-0.5">
              ${initial}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-2 mb-1.5">
                <h4 class="font-bold text-white text-sm sm:text-base tracking-wide">${safeName}</h4>
                <span class="text-[11px] px-2 py-0.5 rounded bg-white/5 text-white/50 border border-white/5 font-mono">${formattedDate}</span>
              </div>
              <p class="text-white/80 text-sm leading-relaxed whitespace-pre-line">${safeUcapan}</p>
            </div>
          </div>

          <div class="flex items-center gap-2 self-end sm:self-center">
            <button 
              type="button" 
              onclick="promptDeleteComment(${index})" 
              class="px-3 py-1.5 rounded-lg border border-red-500/20 text-red-400 text-xs font-semibold hover:bg-red-500/10 hover:border-red-500/50 transition-colors flex items-center gap-1.5"
              title="Hapus ucapan ini"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              <span>Hapus</span>
            </button>
          </div>
        `;

        listContainer.appendChild(card);
      });
    }

    function filterComments() {
      const query = (document.getElementById('search-comments-input').value || '').toLowerCase().trim();
      if (!query) {
        renderCommentsList(allComments);
        return;
      }
      const filtered = allComments.filter(item => {
        const nameMatch = (item.nama || '').toLowerCase().includes(query);
        const msgMatch = (item.ucapan || '').toLowerCase().includes(query);
        return nameMatch || msgMatch;
      });
      renderCommentsList(filtered);
    }

    // ==========================================
    // DELETE COMMENT WORKFLOW
    // ==========================================
    function promptDeleteComment(index) {
      pendingDeleteTarget = allComments[index];
      if (!pendingDeleteTarget) return;

      document.getElementById('delete-modal-guest-name').textContent = pendingDeleteTarget.nama;
      document.getElementById('delete-modal-message').textContent = `"${pendingDeleteTarget.ucapan}"`;

      document.getElementById('modal-delete').classList.remove('hidden');
    }

    function closeDeleteModal() {
      pendingDeleteTarget = null;
      document.getElementById('modal-delete').classList.add('hidden');
    }

    async function executeDeleteComment() {
      if (!pendingDeleteTarget) return;

      const btnConfirm = document.getElementById('btn-confirm-delete');
      const pass = savedAdminPassword || DEFAULT_ADMIN_PASSWORD;

      btnConfirm.disabled = true;
      btnConfirm.innerHTML = `
        <svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
        <span>Menghapus...</span>
      `;

      const scriptUrl = getScriptUrl();

      try {
        if (scriptUrl === DEFAULT_SCRIPT_URL) {
          // Delete from local storage
          const localKey = `guestbook_${clientId}`;
          allComments = allComments.filter(item => item.timestamp !== pendingDeleteTarget.timestamp);
          localStorage.setItem(localKey, JSON.stringify(allComments));
          
          showToast('Ucapan berhasil dihapus!');
          closeDeleteModal();
          renderCommentsList(allComments);
          document.getElementById('tab-ucapan-badge').textContent = allComments.length;
        } else {
          // Delete from Google Apps Script
          const res = await fetch(scriptUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain' },
            body: JSON.stringify({
              action: 'delete',
              id: clientId,
              timestamp: pendingDeleteTarget.timestamp,
              password: pass
            })
          });

          const json = await res.json();
          if (json && json.status === 'success') {
            showToast('Ucapan berhasil dihapus!');
            closeDeleteModal();
            loadComments(false);
          } else {
            showToast(json.message || 'Gagal menghapus ucapan', true);
          }
        }
      } catch (err) {
        showToast('Terjadi kesalahan saat menghapus', true);
      } finally {
        btnConfirm.disabled = false;
        btnConfirm.innerHTML = '<span>Hapus Sekarang</span>';
      }
    }

    // ==========================================
    // SETTINGS MODAL LOGIC
    // ==========================================
    function toggleSettingsModal() {
      const modal = document.getElementById('modal-settings');
      modal.classList.toggle('hidden');
    }

    function saveGasUrlSettings() {
      const input = document.getElementById('input-gas-url');
      const val = (input.value || '').trim();
      localStorage.setItem(STORAGE_KEY_GAS_URL, val);
      showToast('URL Google Apps Script disimpan!');
      toggleSettingsModal();
      loadComments(true);
    }

    // ==========================================
    // COMMON TOAST NOTIFICATION
    // ==========================================
    function showToast(message, isError = false) {
      const toast = document.getElementById('toast');
      const msg = document.getElementById('toast-msg');
      
      msg.textContent = message;
      if (isError) {
        toast.className = 'fixed bottom-10 left-1/2 -translate-x-1/2 z-[200] bg-red-600 text-white px-6 py-3 rounded-full shadow-[0_0_20px_rgba(220,38,38,0.3)] text-sm font-semibold transition-all duration-300 pointer-events-none flex items-center gap-2 toast-enter';
      } else {
        toast.className = 'fixed bottom-10 left-1/2 -translate-x-1/2 z-[200] bg-brand-gold text-black px-6 py-3 rounded-full shadow-[0_0_20px_rgba(207,166,112,0.3)] text-sm font-semibold transition-all duration-300 pointer-events-none flex items-center gap-2 toast-enter';
      }

      setTimeout(() => {
        toast.classList.remove('toast-enter');
        toast.classList.add('toast-leave');
      }, 3000);
    }
  </script>
</body>
</html>
