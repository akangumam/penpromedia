---
---
<section id="services" class="w-full flex flex-col lg:flex-row min-h-[600px] border-t border-white/10">
            <!-- Card 1: WEDDING -->
            <div class="relative w-full lg:w-1/4 min-h-[600px] lg:min-h-[700px] flex flex-col justify-center items-center p-6 lg:p-10 text-center price-card border-b lg:border-b-0 lg:border-r border-white/10 overflow-hidden cursor-pointer group">
                <div class="absolute inset-0 bg-[url('/assets/img/slider_02_javanese_wedding.jpg')] bg-cover bg-center"></div>
                <div class="absolute inset-0 bg-dark-bg/80 group-hover:bg-dark-bg/95 transition-colors duration-500"></div>
                
                <!-- Default State -->
                <div class="relative z-10 flex flex-col items-center justify-center h-full w-full transform group-hover:opacity-0 group-hover:-translate-y-8 transition-all duration-500">
                    <p class="text-xs font-bold tracking-[0.2em] uppercase text-white/70 mb-2">Pernikahan</p>
                    <h3 class="text-2xl md:text-3xl font-bold text-white mb-2">Foto & Video Pernikahan</h3>
                    <p class="text-gold text-sm tracking-widest font-semibold uppercase mt-4">Mulai Rp 1.500.000</p>
                </div>

                <!-- Hover Details -->
                <div class="absolute inset-0 z-20 flex flex-col justify-center p-8 opacity-0 group-hover:opacity-100 transform translate-y-16 group-hover:translate-y-0 transition-all duration-700 text-left overflow-y-auto">
                    
                    <div class="mb-5 mt-32 lg:mt-48">
                        <h4 class="text-gold font-bold mb-1 text-sm tracking-wider">PAKET SILVER <span class="text-white ml-2 text-xs">Rp 1.500.000</span></h4>
                        <ul class="text-[11px] text-white/60 space-y-1 list-disc list-inside">
                            <li>Liputan maksimal 8 jam</li>
                            <li>Foto resolusi tinggi tanpa batas</li>
                            <li>Galeri online (g.drive)</li>
                            <li>50 foto digital yang diedit</li>
                            <li>Album foto magnetik 10 sheet (22 hal)</li>
                        </ul>
                    </div>

                    <div class="mb-5">
                        <h4 class="text-gold font-bold mb-1 text-sm tracking-wider">PAKET MAGNETIK <span class="text-white ml-2 text-xs">Rp 2.500.000</span></h4>
                        <ul class="text-[11px] text-white/60 space-y-1 list-disc list-inside">
                            <li>Liputan foto & video max 10 jam</li>
                            <li>1 fotografer & 1 videografer</li>
                            <li>Video cinematik 2-4 menit</li>
                            <li>100 foto digital yang diedit</li>
                            <li>Album foto magnetik 10 sheet (22 hal)</li>
                            <li>Free Flashdisk 8GB</li>
                        </ul>
                    </div>

                    <div class="mb-5">
                        <h4 class="text-gold font-bold mb-1 text-sm tracking-wider">PAKET KOLASE <span class="text-white ml-2 text-xs">Rp 3.500.000</span></h4>
                        <ul class="text-[11px] text-white/60 space-y-1 list-disc list-inside">
                            <li>Liputan foto & video max 10 jam</li>
                            <li>1 fotografer & 1 videografer</li>
                            <li>Video cinematik 2-4 menit</li>
                            <li>200 foto digital yang diedit</li>
                            <li>Album foto kolase full edit 10 sheet (22 hal)</li>
                            <li>Free Flashdisk 8GB</li>
                        </ul>
                    </div>
                    
                    <button class="mt-auto bg-gold hover:bg-gold-hover text-white text-[10px] font-bold tracking-widest uppercase py-3 px-8 transition-colors w-full">Hubungi Sekarang</button>
                </div>
            </div>

            <!-- Card 2: PREWEDDING -->
            <div class="relative w-full lg:w-1/4 min-h-[600px] lg:min-h-[700px] flex flex-col justify-center items-center p-6 lg:p-10 text-center price-card border-b lg:border-b-0 lg:border-r border-white/10 overflow-hidden cursor-pointer group">
                <div class="absolute inset-0 bg-[url('/assets/img/slider_04_javanese_prewedding.jpg')] bg-cover bg-center"></div>
                <div class="absolute inset-0 bg-dark-bg/80 group-hover:bg-dark-bg/95 transition-colors duration-500"></div>
                
                <!-- Default State -->
                <div class="relative z-10 flex flex-col items-center justify-center h-full w-full transform group-hover:opacity-0 group-hover:-translate-y-8 transition-all duration-500">
                    <p class="text-xs font-bold tracking-[0.2em] uppercase text-white/70 mb-2">Pra-Nikah</p>
                    <h3 class="text-2xl md:text-3xl font-bold text-white mb-2">Fotografi</h3>
                    <p class="text-gold text-sm tracking-widest font-semibold uppercase mt-4">Rp 1.700.000</p>
                </div>

                <!-- Hover Details -->
                <div class="absolute inset-0 z-20 flex flex-col justify-center p-8 opacity-0 group-hover:opacity-100 transform translate-y-16 group-hover:translate-y-0 transition-all duration-700 text-left overflow-y-auto">
                    
                    <div class="mb-6 mt-32 lg:mt-48">
                        <h4 class="text-gold font-bold mb-1 text-sm tracking-wider">HANYA FOTO</h4>
                        <p class="text-white/40 text-[10px] mb-4 uppercase tracking-widest">Foto & Tata Rias (Mahsyaril Wedding)</p>
                        <h5 class="text-white text-xs font-bold mb-2 tracking-widest uppercase">Termasuk:</h5>
                        <ul class="text-xs text-white/60 space-y-2 list-disc list-inside">
                            <li>3 jam sesi foto</li>
                            <li>Set baju adat jawa / gaun</li>
                            <li>Studio foto</li>
                            <li>Foto resolusi tinggi tanpa batas</li>
                            <li>50 foto digital yang diedit</li>
                            <li>Galeri online (tautan g.drive)</li>
                            <li>Cetak 40x60 = 2 + bingkai minimalis</li>
                        </ul>
                    </div>
                    
                    <button class="mt-auto bg-gold hover:bg-gold-hover text-white text-[10px] font-bold tracking-widest uppercase py-3 px-8 transition-colors w-full">Hubungi Kami</button>
                </div>
            </div>

            <!-- Card 3: GRADUATION -->
            <div class="relative w-full lg:w-1/4 min-h-[600px] lg:min-h-[700px] flex flex-col justify-center items-center p-6 lg:p-10 text-center price-card border-b lg:border-b-0 lg:border-r border-white/10 overflow-hidden cursor-pointer group">
                <div class="absolute inset-0 bg-[url('/assets/img/gallery_indo_2.jpg')] bg-cover bg-center"></div>
                <div class="absolute inset-0 bg-dark-bg/80 group-hover:bg-dark-bg/95 transition-colors duration-500"></div>
                
                <!-- Default State -->
                <div class="relative z-10 flex flex-col items-center justify-center h-full w-full transform group-hover:opacity-0 group-hover:-translate-y-8 transition-all duration-500">
                    <p class="text-xs font-bold tracking-[0.2em] uppercase text-white/70 mb-2">Wisuda</p>
                    <h3 class="text-2xl md:text-3xl font-bold text-white mb-2">Sesi Foto</h3>
                    <p class="text-gold text-sm tracking-widest font-semibold uppercase mt-4">Mulai Rp 350.000</p>
                </div>

                <!-- Hover Details -->
                <div class="absolute inset-0 z-20 flex flex-col justify-center p-8 opacity-0 group-hover:opacity-100 transform translate-y-16 group-hover:translate-y-0 transition-all duration-700 text-left overflow-y-auto">
                    
                    <div class="mb-6 mt-32 lg:mt-48">
                        <h4 class="text-gold font-bold mb-4 text-sm tracking-wider">PAKET WISUDA</h4>
                        <ul class="text-xs text-white/60 space-y-2 list-disc list-inside">
                            <li>1 jam sesi foto</li>
                            <li>File foto tanpa batas</li>
                            <li>File digital via g.drive</li>
                            <li>Gratis 50 foto editan</li>
                        </ul>
                    </div>
                    
                    <button class="mt-auto bg-gold hover:bg-gold-hover text-white text-[10px] font-bold tracking-widest uppercase py-3 px-8 transition-colors w-full">Informasi Booking</button>
                </div>
            </div>

            <!-- Card 4: UNDANGAN DIGITAL -->
            <div class="relative w-full lg:w-1/4 min-h-[600px] lg:min-h-[700px] flex flex-col justify-center items-center p-6 lg:p-10 text-center price-card overflow-hidden cursor-pointer group">
                <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1522673607200-164d1b6ce486?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80')] bg-cover bg-center"></div>
                <div class="absolute inset-0 bg-dark-bg/80 group-hover:bg-dark-bg/95 transition-colors duration-500"></div>
                
                <!-- Default State -->
                <div class="relative z-10 flex flex-col items-center justify-center h-full w-full transform group-hover:opacity-0 group-hover:-translate-y-8 transition-all duration-500">
                    <p class="text-xs font-bold tracking-[0.2em] uppercase text-white/70 mb-2">Website</p>
                    <h3 class="text-2xl md:text-3xl font-bold text-white mb-2">Undangan Digital</h3>
                    <p class="text-gold text-sm tracking-widest font-semibold uppercase mt-4">Mulai Rp 100.000</p>
                </div>

                <!-- Hover Details -->
                <div class="absolute inset-0 z-20 flex flex-col justify-center p-8 opacity-0 group-hover:opacity-100 transform translate-y-16 group-hover:translate-y-0 transition-all duration-700 text-left overflow-y-auto">
                    
                    <div class="mb-6 mt-32 lg:mt-48">
                        <h4 class="text-gold font-bold mb-2 text-sm tracking-wider">PAKET BASIC <span class="text-white ml-2 text-xs">Rp 100.000</span></h4>
                        <ul class="text-[11px] text-white/60 space-y-1 list-disc list-inside mb-5">
                            <li>Desain Premium Pilihan</li>
                            <li>Revisi Tanpa Batas (Sampai Fix)</li>
                            <li>Fitur RSVP & Buku Tamu</li>
                            <li>Masa Aktif 6 Bulan</li>
                        </ul>

                        <h4 class="text-gold font-bold mb-2 text-sm tracking-wider">PAKET PREMIUM <span class="text-white ml-2 text-xs">Rp 250.000</span></h4>
                        <ul class="text-[11px] text-white/60 space-y-1 list-disc list-inside">
                            <li>Semua Fitur Basic</li>
                            <li>Custom Nama Domain</li>
                            <li>Galeri Foto Tanpa Batas</li>
                            <li>Video Background</li>
                            <li>Masa Aktif Selamanya</li>
                        </ul>
                    </div>
                    
                    <button class="mt-auto bg-gold hover:bg-gold-hover text-white text-[10px] font-bold tracking-widest uppercase py-3 px-8 transition-colors w-full">Buat Undangan</button>
                </div>
            </div>
        </section>