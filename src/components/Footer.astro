<footer id="contacts" class="bg-dark-surface pt-16 pb-8 px-6 lg:px-24">
            <!-- Top Social Links -->
            <div class="flex justify-center space-x-8 border-b border-white/5 pb-10 mb-10 text-xs font-bold tracking-[0.2em] uppercase text-white/50">
                <a href="https://www.facebook.com/penpro.media" target="_blank" class="hover:text-white transition-colors flex items-center">
                    <img src="/assets/img/facebook.svg" class="w-4 h-4 mr-2" style="filter: invert(1) brightness(2);" alt="Facebook">
                    Facebook
                </a>
                <a href="https://www.tiktok.com/@penpromedia" target="_blank" class="hover:text-white transition-colors flex items-center">
                    <img src="/assets/img/tiktok.svg" class="w-4 h-4 mr-2" style="filter: invert(1) brightness(2);" alt="TikTok">
                    TikTok
                </a>
                <a href="https://www.instagram.com/penpromedia/" target="_blank" class="hover:text-white transition-colors flex items-center">
                    <img src="/assets/img/instagram.svg" class="w-4 h-4 mr-2" style="filter: invert(1) brightness(2);" alt="Instagram">
                    Instagram
                </a>
            </div>

            <!-- Footer Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
                <!-- Column 1 -->
                <div>
                    <!-- Logo Area -->
                    <img src="/assets/img/penpromedia_logo.png" alt="Penpromedia Logo" class="h-12 w-auto mb-6">
                    
                    <p class="text-white/60 text-sm leading-loose mb-8 max-w-sm">
                        Lebih dari sekadar agensi visual. Kami hadir sebagai pendongeng untuk merekam momen sakral Anda melalui karya fotografi berkelas dan undangan digital yang elegan.
                    </p>
                    <button class="bg-[#d2a76f] hover:bg-gold-hover text-white text-xs font-bold tracking-widest uppercase py-3 px-8 transition-colors rounded-full">
                        Mulai Sekarang
                    </button>
                </div>
                
                <!-- Column 2 -->
                <div>
                    <h4 class="text-lg font-bold mb-6">Foto Terbaru</h4>
                    <div class="flex space-x-2">
                        <img src="/assets/img/slider_02_javanese_wedding.jpg" alt="Thumb 1" class="w-20 h-20 object-cover cursor-pointer hover:opacity-80 transition-opacity">
                        <img src="/assets/img/slider_04_city_lights.jpg" alt="Thumb 2" class="w-20 h-20 object-cover cursor-pointer hover:opacity-80 transition-opacity">
                        <img src="/assets/img/slider_05_strobist.jpg" alt="Thumb 3" class="w-20 h-20 object-cover cursor-pointer hover:opacity-80 transition-opacity">
                    </div>
                </div>
                
                <!-- Column 3 -->
                <div>
                    <h4 class="text-lg font-bold mb-6">Kontak</h4>
                    <div class="space-y-2 text-sm text-white/70">
                        <p><span class="text-white/40 uppercase text-xs tracking-wider">Telepon:</span> <a href="https://wa.me/6285155256594" target="_blank" class="hover:text-[#d2a76f] transition-colors">+62 85155256594</a></p>
                        <p><span class="text-white/40 uppercase text-xs tracking-wider">Email:</span> <a href="mailto:hello@penpromedia.com" class="hover:text-[#d2a76f] transition-colors">hello@penpromedia.com</a></p>
                    </div>
                    <p class="text-xs text-white/30 mt-8">&copy; 2026 Penpromedia. Hak Cipta Dilindungi.</p>
                </div>
            </div>
        </footer>